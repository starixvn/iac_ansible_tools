version: "3.8"
services:
  elasticsearch:
    image: registry.nexdev.net:5050/docker/jaeger/elasticsearch:7.17.0
    networks:
      - '{{swarm_network_nexops}}'   
    restart: on-failure
    environment:
      - cluster.name=jaeger-cluster
      - discovery.type=single-node
      - http.host=0.0.0.0
      - transport.host=127.0.0.1
      - ES_JAVA_OPTS=-Xms512m -Xmx512m
      - xpack.security.enabled=false
    volumes:
      - jaeger_vol:/usr/share/elasticsearch/data
    deploy:
      mode: replicated
      replicas: {{replicas | default (1)}}
      placement:
        constraints:
          - node.labels.{{label_node | default ('NEXOPS_HIGH_STORAGE')}} == yes

  jaeger-collector:
    image: registry.nexdev.net:5050/docker/jaeger/jaeger-collector:latest
    ports:
      - "14269:14269"
      - "14268:14268"
      - "14250:14250"
      - "9411:9411"
    networks:
      - '{{swarm_network_nexops}}'
    restart: on-failure
    environment:
      - SPAN_STORAGE_TYPE=elasticsearch
    deploy:
      mode: replicated
      replicas: {{replicas | default (1)}}
      placement:
        constraints:
          - node.labels.{{label_node | default ('NEXOPS_HIGH_STORAGE')}} == yes
    command: [
      "--es.server-urls=http://elasticsearch:9200",
      "--es.num-shards=1",
      "--es.num-replicas=0",
      "--log-level=error"
    ]
    depends_on:
      - elasticsearch

  jaeger-agent:
    image: registry.nexdev.net:5050/docker/jaeger/jaeger-agent:latest
    hostname: jaeger-agent
    command: ["--reporter.grpc.host-port=jaeger-collector:14250"]
    ports:      
      - "6831:6831/udp"
      - "6832:6832/udp"
      - "5778:5778"
      - "14271:14271"
    networks:
      - '{{swarm_network_nexops}}'
    restart: on-failure
    deploy:
      mode: replicated
      replicas: {{replicas | default (1)}}
      placement:
        constraints:
          - node.labels.{{label_node | default ('NEXOPS_HIGH_STORAGE')}} == yes
    environment:
      - SPAN_STORAGE_TYPE=elasticsearch
    depends_on:
      - jaeger-collector

  jaeger-query:
    image: registry.nexdev.net:5050/docker/jaeger/jaeger-query:latest
    environment:
      - SPAN_STORAGE_TYPE=elasticsearch
      - no_proxy=localhost
    deploy:
      mode: replicated
      replicas: {{replicas | default (1)}}
      placement:
        constraints:
          - node.labels.{{label_node | default ('NEXOPS_HIGH_STORAGE')}} == yes
    ports:
      - "16686:16686"
      - "16687:16687"
    networks:
      - '{{swarm_network_nexops}}'
    restart: on-failure
    command: [
      "--es.server-urls=http://elasticsearch:9200",
      "--span-storage.type=elasticsearch",
      "--log-level=debug"
    ]
    depends_on:
      - jaeger-agent

volumes:
  jaeger_vol:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: {{gluster_path}}/jaeger/storage

networks:
  {{ swarm_network_nexops }}:
    external: true