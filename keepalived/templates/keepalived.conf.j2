global_defs {
  smtp_server localhost
  vrrp_version 2
  script_user root root enable_script_security
}

vrrp_script haproxy_container {
    script "/etc/keepalived/haproxy-curl-check.sh"
    interval 1
    weight -20
    fall 3
    rise 3
}

vrrp_instance VI_0 {
    interface {{nic}}
    state {{keepalive_role}}
    virtual_router_id {{virtual_router_id | default('205')}}
    priority {{keepalive_priority}}
    virtual_ipaddress {
        {{vip}}
    }
    authentication {
    auth_type PASS
    auth_pass {{ keepalived_password }}
  	}
    track_script {
        haproxy_container
    }
    notify "/etc/keepalived/keepalived_notify.sh"
}

{% if vip1 is defined %}
