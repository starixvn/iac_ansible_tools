version: '3.1'

services:
  verdaccio:
    image: verdaccio/verdaccio
    environment:
      - VERDACCIO_PORT=4873
    # ports:
    #   - '4874:4873'
    volumes:
      - data:/verdaccio/storage
    networks:
      - { { swarm_nexops_network } }
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.NEXOPS == yes
volumes:
  data:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: /var/www/gluster/nexops/verdaccio/storage

networks:
  { { swarm_nexops_network } }:
    external: true
