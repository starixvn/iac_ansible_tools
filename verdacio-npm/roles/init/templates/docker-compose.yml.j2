version: '3.7'

services:
  verdaccio_npm:
    image: registry.nexdev.net:5050/docker/nexops-tools/verdaccio #verdaccio/verdaccio
    environment:
      - VERDACCIO_PORT=4873
    # ports:
    #   - '4874:4873'
    volumes:
      - verdaccio_npm_vol:/verdaccio/storage
    networks:
      - {{ swarm_network_nexops }}
    deploy:
      mode: replicated
      replicas: 1
      endpoint_mode: dnsrr
      placement:
        constraints:
          - node.labels.{{label_node | default ('NEXOPS')}} == yes
volumes:
  verdaccio_npm_vol:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: {{gluster_path}}/verdaccio_npm/storage

networks:
  {{ swarm_network_nexops }}:
    external: true
