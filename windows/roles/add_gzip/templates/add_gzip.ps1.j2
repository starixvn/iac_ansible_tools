{% for gzip in gzips %}
if(((Get-WebConfigurationProperty -pspath 'MACHINE/WEBROOT/APPHOST' -filter "system.webServer/httpCompression" -Name "dynamicTypes").Collection  | Where-Object { $_.mimeType -eq '{{gzip.name}}' }).Length -eq 1){
    Write-Host "'{{gzip.name}}' already configured"
} else {
    Add-WebConfigurationProperty -pspath 'MACHINE/WEBROOT/APPHOST'  -filter "system.webServer/httpCompression/dynamicTypes" -name "." -value @{mimeType='{{gzip.name}}';enabled='True'}
    Write-Host "'{{gzip.name}}' added successfully"
}
{% endfor %}