version: "3"
services:
  redis:
    image: registry.nexdev.net:5050/docker/database/redis:6.2-rc
    ports:
      - "16379:6379"
    volumes:
      - data:/data
    deploy:
      #mode: global
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.NEXOPS_LOW_STORAGE == yes
    command: redis-server --appendonly yes
    networks:
      - {{swarm_network_nexops}}

networks:
  {{swarm_network_nexops}}:
     external: true

volumes:
  data:
    driver_opts:
      o: bind
      type: none
      device: {{gluster_path}}/redis