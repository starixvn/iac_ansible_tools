version: "3"
services:
  redis:
    image: registry.nexdev.net:5050/docker/database/redis:{{redis_version | default ('5')}}
    ports:
      - "{{external_port | default ('13379')}}:6379"
    volumes:
      - ./redis.conf:/etc/redis/redis.conf
      - ./data:/data
      - ./logs:/var/tmp/
      - /etc/localtime:/etc/localtime:ro
    sysctls:
      - net.core.somaxconn=65365
    deploy:
      #mode: global
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.{{node_label | default ('NEXOPS_LOW_STORAGE')}} == yes
    command: redis-server /etc/redis/redis.conf
    #command: redis-server --appendonly yes
    healthcheck:
      test: ["CMD", "redis-cli","ping"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - {{swarm_network_nexops}}

networks:
  {{swarm_network_nexops}}:
     external: true