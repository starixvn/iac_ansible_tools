version: '3.3'
services:
    {{mysql_name}}_db:
        image: registry.nexdev.net:5050/docker/database/mysql:{{version}}
        command: --default-authentication-plugin=mysql_native_password
        ports:
            - published: {{mysql_port}}
              target: 3306
              mode: ingress
        environment:
            - MYSQL_DATABASE=database
            - MYSQL_ROOT_PASSWORD=1qaz@WSX
            - MYSQL_USER=mysql_user
            - MYSQL_PASSWORD=Pass1234AA
        volumes:
            - {{db_volume}}:/var/lib/mysql
            - {{ gluster_path }}/{{team_path}}/custom-mysql.cnf:/etc/mysql/conf.d/custom-mysql.cnf
        healthcheck:
            test: out=$$(mysqladmin ping -h localhost -P 3306 -u root --password=1qaz@WSX 2>&1); echo $$out | grep 'mysqld is alive' || { echo $$out; exit 1; }
            interval: 5s
            timeout: 20s
            retries: 30
        deploy:
            mode: replicated
            replicas: 1
            placement:
                constraints:
                - node.labels.{{node_label | default ('NEXCEL_HIGH_STORAGE')}} == yes
        networks:
            - {{network | default('swarm_nexops')}}
        labels:
{% if env == "prod" or env == "aws" %}
      - "io.portainer.accesscontrol.teams={{team_name | upper}}_LEADERS"
{% else %}
      - "io.portainer.accesscontrol.teams={{team_name | upper}}"

    
    {{mysql_name}}_phpmyadmin:
        image: registry.nexdev.net:5050/docker/phpmyadmin:latest
        volumes:
            - {{gluster_path}}/{{team_path}}/phpadmin/uploads.ini:/usr/local/etc/php/conf.d/php-phpmyadmin.ini
        restart: always
        ports:
            - {{phpadmin_port}}:80
        environment:
            MYSQL_USERNAME: mysql_user
            MYSQL_ROOT_PASSWORD: Pass1234AA
            PMA_HOSTS: {{mysql_name}}_db
        deploy:
            mode: replicated
            replicas: 1
            placement:
                constraints:
                - node.labels.{{node_label | default ('NEXCEL_HIGH_STORAGE')}} == yes
        networks:
            - {{network | default('swarm_nexops')}}
        labels:
{% if env == "prod" or env == "aws" %}
      - "io.portainer.accesscontrol.teams={{team_name | upper}}_LEADERS"
{% else %}
      - "io.portainer.accesscontrol.teams={{team_name | upper}}"

networks:
  {{network | default('swarm_nexops')}}:
    external: true

volumes:
  {{db_volume}}:
    driver_opts:
      o: bind
      type: none
      device: {{gluster_path}}/{{team_path}}/data