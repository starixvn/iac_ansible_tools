version: '3.5'
networks:
  {{swarm_network_nexops}}:
    external: true

# https://docs.influxdata.com/influxdb/v1.7/administration/config
services:
  influxdb:
    image: registry.nexdev.net:5050/docker/database/influxdb:{{version}}
    ports:
      - published: {{port}}
        target: 8086
        mode: ingress
    environment:
      INFLUXDB_DB: "{{INFLUXDB_DB}}" #"FanexRemotingRef"
      INFLUXDB_HTTP_AUTH_ENABLED: 'true'
      INFLUXDB_USER: "{{INFLUXDB_USER}}" #influx
      INFLUXDB_USER_PASSWORD: "{{INFLUXDB_USER_PASSWORD}}" #influxdb@Pass
      INFLUXDB_ADMIN_USER: influxadmin
      INFLUXDB_ADMIN_PASSWORD: AdmiN1234
    deploy:
      mode: replicated
      replicas: 1
#      labels:
#        prometheus.enable: "true"
#        prometheus.port: "{{port}}"
#        prometheus.path: "/metrics"
      placement:
        constraints:
        - node.labels.{{node_label | default ('NEXOPS_HIGH_STORAGE')}} == yes
#      resources:
#        limits:
#          memory: 2048M
#        reservations:
#          memory: 1024M
    networks:
    - {{swarm_network_nexops}}
    volumes:
      - {{volume_path}}:/var/lib/influxdb