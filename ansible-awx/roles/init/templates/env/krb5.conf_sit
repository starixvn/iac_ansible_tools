#winrm
# BEGIN -- dynamic data
[libdefaults]
  default_realm = SIE.COM
  # The following krb5.conf variables are only for MIT Kerberos.
          krb4_config = /etc/krb.conf
          krb4_realms = /etc/krb.realms
          kdc_timesync = 1
          ccache_type = 4
          forwardable = true
          proxiable = true
  # The following libdefaults parameters are only for Heimdal Kerberos.
          v4_instance_resolve = false
          v4_name_convert = {
                  host = {
                          rcmd = host
                          ftp = ftp
                  }
                  plain = {
                          something = something-else
                  }
          }
          fcc-mit-ticketflags = true
  [realms]
          SIE.COM = {
          kdc = 172.16.4.242
          admin_server = 172.16.4.242
          }
  [domain_realm]
          .sie.com = SIE.COM
           sie.com = SIE.COM
  [login]
          krb4_convert = true
          krb4_get_tickets = false
# END -- dynamic data