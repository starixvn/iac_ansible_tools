---
tls:
  certificates:
    - certFile: "/etc/traefik/dynamic_conf/certs/fullchain.pem"
      keyFile: "/etc/traefik/dynamic_conf/certs/privkey.pem"
      stores:
        - default
  stores:
    default:
      defaultCertificate:
        certFile: "/etc/traefik/dynamic_conf/certs/fullchain.pem"
        keyFile: "/etc/traefik/dynamic_conf/certs/privkey.pem"