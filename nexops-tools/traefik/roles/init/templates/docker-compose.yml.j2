version: "3.8"
services:
  proxy:
    image: {{ lookup('vars', org + '_traefik_image_' + env)}}/traefik:{{traefik_version}}
    command:
      - --log.level=INFO #DEBUG
      - --api.insecure=true # set to 'false' on pr
      - --api.dashboard=true # see https://docs.traefik.io/v2.0/operations/dashboard/#secure-mode for how to secure the dashboard
      - --providers.docker=true
      - --providers.docker.swarmMode=true
      - --providers.docker.exposedbydefault=false
      - --metrics.prometheus=true
      - --metrics.prometheus.buckets=0.1,0.3,1.2,5.0
      - --providers.docker.watch
      - --entrypoints.web.address=:8800
      - --entrypoints.websecure.address=:4400
      - --providers.file.directory=/etc/traefik/dynamic_conf
      - --accesslog
    
    ports:
{% for port in lookup('vars', team + '_ports_' + env) %}
      - published: {{port.published}}
        target: {{port.target}}
        mode: {{port.mode}}
{% endfor %}

    networks:
{% for swarm_network in swarm_networks %}
      - {{swarm_network}}
{% endfor %}
      - {{swarm_network_nexops}}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
{% if env == "local" or env == "local_test" %}
      - data:/etc/traefik/dynamic_conf
{% endif %}
      - /etc/localtime:/etc/localtime:ro
    deploy:
      labels: #{}
        - "traefik.enable=true"
        - "traefik.http.routers.proxy_traefik.rule=Host(`{{dashboard_domain}}`)" # domain for dashboard
        - "traefik.http.routers.proxy_traefik.entrypoints=web"
        #- "traefik.http.routers.proxy_traefik.tls=true"
        - "traefik.http.services.proxy_traefik.loadbalancer.server.port=8080"
        - "traefik.http.routers.proxy_traefik.middlewares=auth" # enable password auth
        - "traefik.http.middlewares.auth.basicauth.users=admin:$$apr1$$Cxc/yICo$$fzbntEa9HlDGiDiLNVniz0" # substitute with your htpasswd string and escape dollar signs!
      placement:
        constraints:
          - node.labels.HAPROXY == yes
      restart_policy:
        condition: on-failure
##
networks:
{% for swarm_network in swarm_networks %}
  {{swarm_network}}:
    external: true
{% endfor %}
  {{swarm_network_nexops}}:
    external: true

volumes:
  data:
    driver: local
    driver_opts:
       o: bind
       type: none
       device: {{volume_path}}