version: "3.8"
configs:
  "{{redis_config}}":
    file: "{{gluster_path}}/redis.conf"
services:

  node_sentinel:
    image: hub.nexdev.net/base/nexops-tools/redis-sentinel:{{item.redis_stack}}_{{item.redis_version}}
    deploy:
      mode: replicated
      replicas: 3
      placement:
        constraints:
          - node.labels.REDIS_SENTINAL == yes
    environment:
      - REDIS_MASTER_HOST={{item.master}}
    networks:
      - host

  node1:
    image: hub.nexdev.net/base/database/redis:{{item.redis_stack}}_{{item.redis_version}}
    healthcheck:
      test: ["CMD", "redis-cli", "-p", "{{item.redis_port}}", "-a", "foo1@bared", "ping"]
      interval: 3s
      timeout: 5s
      retries: 10
    deploy:
      mode: global
      placement:
        constraints:
          - node.labels.{{system}}_redis_node_1 == yes
    volumes:
      #- ./redis.conf:/etc/redis/redis.conf
      - ./data:/data
    configs:
      - source: "{{redis_config}}"
        target: /etc/redis/redis.conf
    networks:
      - host

  node2:
    image: hub.nexdev.net/base/database/redis:{{item.redis_stack}}_{{item.redis_version}}
    healthcheck:
      test: ["CMD", "redis-cli", "-p", "{{item.redis_port}}", "-a", "foo1@bared", "ping"]
      interval: 3s
      timeout: 5s
      retries: 10
    environment:
      - REDIS_MASTER_HOST={{item.master}}
    deploy:
      mode: global
      placement:
        constraints:
          - node.labels.{{system}}_redis_node_2 == yes
    volumes:
      #- ./redis.conf:/etc/redis/redis.conf
      - ./data:/data
    configs:
      - source: "{{redis_config}}"
        target: /etc/redis/redis.conf
    networks:
      - host

  node3:
    image: hub.nexdev.net/base/database/redis:{{item.redis_stack}}_{{item.redis_version}}
    healthcheck:
      test: ["CMD", "redis-cli", "-p", "{{item.redis_port}}", "-a", "foo1@bared", "ping"]
      interval: 3s
      timeout: 5s
      retries: 10
    environment:
      - REDIS_MASTER_HOST={{item.master}}
    deploy:
      mode: global
      placement:
        constraints:
          - node.labels.{{system}}_redis_node_3 == yes
    volumes:
      #- ./redis.conf:/etc/redis/redis.conf
      - ./data:/data
    configs:
      - source: "{{redis_config}}"
        target: /etc/redis/redis.conf
    networks:
      - host
  
  heathcheck:
    image: hub.nexdev.net/base/nexops-tools/redis-healthcheck:{{item.redis_stack}}_{{item.redis_version}}
    ports:
      - "{{item.sentinel_port}}:611"
    deploy:
      mode: replicated
      replicas: 1
      #mode: global
      placement:
        constraints:
          - node.labels.REDIS_SENTINAL == yes
    environment:
      - SENTINEL_HOST={{item.master}}

networks:
  host:
    external: true