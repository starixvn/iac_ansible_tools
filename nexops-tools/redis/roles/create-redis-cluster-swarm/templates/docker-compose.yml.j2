version: "3.3"
services:

  node_sentinel:
    image: hub.nexdev.net/base/nexops-tools/redis-sentinel:{{item.redis_stack}}_{{item.redis_version}}
    deploy:
      mode: replicated
      replicas: 3
      placement:
        constraints:
          - node.labels.REDIS_SENTINAL == yes
    environment:
      - REDIS_MASTER_HOST={{item.master}}
    #  - SENTINEL_DOWN_AFTER=5000 #5000
    #  - SENTINEL_FAILOVER=30000 #15000
    #volumes:
    #  - alpha_redis_sentinel_conf:/etc/redis
    networks:
      - host

  node1:
    image: hub.nexdev.net/base/database/redis:{{item.redis_stack}}_{{item.redis_version}}
    healthcheck:
      test: ["CMD", "redis-cli", "-p", "6312", "-a", "foo1@bared", "ping"]
      interval: 3s
      timeout: 5s
      retries: 10
    deploy:
      mode: global
      placement:
        constraints:
          - node.labels.{{system}}_redis_node_1 == yes
    volumes:
      - ./data:/data
    networks:
      - host

  node2:
    image: hub.nexdev.net/base/database/redis:{{item.redis_stack}}_{{item.redis_version}}
    healthcheck:
      test: ["CMD", "redis-cli", "-p", "6312", "-a", "foo1@bared", "ping"]
      interval: 3s
      timeout: 5s
      retries: 10
    environment:
      - REDIS_MASTER_HOST={{item.master}}
    deploy:
      mode: global
      placement:
        constraints:
          - node.labels.{{system}}_redis_node_2 == yes
    volumes:
      - ./data:/data
    #  - /proc/:/wproc/
      #- alpha_redis_conf:/etc/redis
    #privileged: true
    networks:
      - host

  node3:
    image: hub.nexdev.net/base/database/redis:{{item.redis_stack}}_{{item.redis_version}}
    healthcheck:
      test: ["CMD", "redis-cli", "-p", "6312", "-a", "foo1@bared", "ping"]
      interval: 3s
      timeout: 5s
      retries: 10
    environment:
      - REDIS_MASTER_HOST={{item.master}}
    deploy:
      mode: global
      placement:
        constraints:
          - node.labels.{{system}}_redis_node_3 == yes
    volumes:
      - ./data:/data
    networks:
      - host
  
  heathcheck:
    image: hub.nexdev.net/base/nexops-tools/redis-healthcheck:{{item.redis_stack}}_{{item.redis_version}}
    ports:
      - "{{item.sentinel_port}}:611"
    deploy:
      mode: replicated
      replicas: 1
      #mode: global
      placement:
        constraints:
          - node.labels.REDIS_SENTINAL == yes
    environment:
      - SENTINEL_HOST={{item.master}}

#volumes:
#  "{{system}}_redis_data":
  #alpha_redis_conf:
  #alpha_redis_sentinel_conf:
networks:
  host:
    external: true