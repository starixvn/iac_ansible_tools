{% if env == "local" or env == "nexprod" %}
{% set hub_url = "{{hub_url}}" %}
{% else %}
{% set hub_url = "nexhub.starixplay.com/kbt" %}
{% endif %}
version: "3"
services:
  {{redis_name | default ('redis')}}:
    image: {{hub_url}}/base/database/redis:{{redis_version | default ('5')}}
    container_name: {{redis_name | default ('redis')}}
    hostname: {{redis_name | default ('redis')}}
    restart: always
{% if external_port is defined%}
    ports:
      - "{{external_port | default ('13379')}}:{{internal_port | default ('6379')}}"
{% endif %}
    volumes:
      - ./redis.conf:/etc/redis/redis.conf
      - ./data:/data
      - ./logs:/var/log/redis/
      - /etc/localtime:/etc/localtime:ro
    sysctls:
      - net.core.somaxconn=65365
    command: redis-server /etc/redis/redis.conf
    network_mode: bridge
    healthcheck:
      test: redis-cli -a {{masterauth | default('foo1@bared')}} -p {{internal_port | default ('6379')}} ping
      interval: 5s
      timeout: 5s
      retries: 5