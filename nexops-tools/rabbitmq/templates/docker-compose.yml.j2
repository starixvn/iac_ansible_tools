version: "3.8"

services:
  rabbit:
    image: registry.nexdev.net:5050/docker/nexops-tools/rabbitmq:3.8.11-management-alpine
    hostname: "rabbit{{'{{'}}.Task.Slot{{'}}'}}"
    healthcheck:
      test: rabbitmq-diagnostics ping
      interval: 1s
      timeout: 2s
      retries: 120
    ports:
      - 15672:15672
      - 5672:5672
    networks:
      - {{swarm_network}}
    deploy:
      mode: replicated
      replicas: 2
      #endpoint_mode: dnsrr
      update_config:
        parallelism: 1
        delay: 20s
      placement:
        constraints:
          - "node.labels.{{node_label}}==yes"
    environment:
      RABBITMQ_DEFAULT_VHOST: "/"
      RABBITMQ_VM_MEMORY_HIGH_WATERMARK: "2048MiB"
    volumes:
      - config:/etc/rabbitmq/
      - data:/var/lib/rabbitmq/

networks:
  {{swarm_network}}:
    external: true

volumes:
  config:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: "{{config_folder}}"
  data:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: "{{data_folder}}"