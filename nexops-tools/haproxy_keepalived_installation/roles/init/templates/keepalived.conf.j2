global_defs {
  smtp_server localhost
  vrrp_version 3
}

vrrp_track_process haproxy {
  delay 2
  process haproxy
  quorum 1
}

vrrp_instance VI_5 {
  accept
  advert_int 1
  interface {{ keepalived_network_interface }}
  state {{ keepalive_role }}
  track_process {
    haproxy
  }
  priority {{ keepalive_priority }}
  unicast_src_ip {{ keepalive_unicast_src_ip }}
  unicast_peer {
    {{ keepalive_unicast_peer }}
  }
  #authentication {
  #  auth_type PASS
  #  auth_pass {{ keepalived_password }}
  #}
  virtual_ipaddress {
  {{ VIRTUAL_IP }}
    }
  virtual_router_id 130
  #notify_master /etc/keepalived/master.sh
}
