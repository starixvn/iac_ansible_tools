###SSH
frontend SSH-in
    bind *:22
    mode tcp
    log global
    ##ACL
    default_backend ssh-proxy-backend
###SMTP
frontend smtp-in
    bind *:25
    mode tcp
    log global
    default_backend smtp_cluster
###Domain HTTP
frontend http-in
    bind *:80
    bind *:443 ssl crt /etc/haproxy/certs/server.pem crt /etc/haproxy/certs/testing2.nexdev.net.pem crt /etc/haproxy/certs/bot.nexdev.net.pem crt /etc/haproxy/certs/docs.nexdev.net.pem crt /etc/haproxy/certs/licbot.nexdev.net.pem crt /etc/haproxy/certs/sentry.nexdev.net.pem
    mode http
    log global
    option  httplog
    timeout client 30m
    timeout server 30m
    timeout check 30s
    #### Define ACL ####
    # LetsEncrypt
    acl letsencrypt-acl path_beg /.well-known/acme-challenge/
    use_backend letsencrypt-backend if letsencrypt-acl
    #
    acl gitlab_host hdr(host) -i gitlab.nexdev.net
    acl redmine_host hdr(host) -i nexdev.net
    acl rocketor_host hdr(host) -i rocketor.nexdev.net
    acl sonarqube_host hdr(host) -i sonarqube.nexdev.net
    acl sonarqubedev_host hdr(host) -i sonarqube-dev.nexdev.net
    acl ndict_host hdr(host) -i ndict.nexdev.net
    acl ndict_host hdr(host) -i ndict.now
    acl ndict_api_host hdr(host) -i api.ndict.now
    acl nuget_host hdr(host) -i nuget.nexdev.net
    acl wekan_host hdr(host) -i boards.nexdev.net
    acl zabbix_host hdr(host) -i zabbix.nexdev.net
    acl hasite_host hdr(host) -i ha.nexdev.net
    acl sentry_host hdr(host) -i sentry.nexdev.net
    acl livescoreapi_host hdr(host) -i testing2.nexdev.net
    acl ndict_api_host hdr(host) -i api.ndict.now
    acl grafana_host hdr(host) -i grafana.nexdev.net
    acl kibana_host hdr(host) -i logs.nexdev.net
    acl licbot_host hdr(host) -i licbot.nexdev.net
    acl docs_host hdr(host) -i docs.nexdev.net
    acl bot_host hdr(host) -i bot.nexdev.net

    ## figure out which one to use
    use_backend gitlab_cluster if gitlab_host
    use_backend redmine_cluster if redmine_host
    use_backend rocketor_cluster if rocketor_host
    use_backend sonarqube_cluster if sonarqube_host
    use_backend sonarqubedev_cluster if sonarqubedev_host
    use_backend ndict_cluster if ndict_host
    use_backend ndict_api_cluster if ndict_api_host
    use_backend nuget_cluster if nuget_host
    use_backend wekan_cluster if wekan_host
    use_backend hasite_cluster if hasite_host
    use_backend sentry_cluster if sentry_host
    use_backend livescoreapi_cluster if livescoreapi_host
    use_backend grafana_cluster if grafana_host
    use_backend zabbix_cluster if zabbix_host
    use_backend kibana_cluster if kibana_host
    use_backend licbot_cluster if licbot_host
    use_backend bot_cluster if bot_host
    use_backend docs_cluster if docs_host

# LE Backend
backend letsencrypt-backend
    mode http
    server letsencrypt 127.0.0.1:1111
### HOSTS
####### HTTP GITLAB.nexdev.net
backend gitlab_cluster
    mode http
    default-server  inter 3s fall 3 rise 2
    #cookie JSESSIONID prefix
    # add X-FORWARDED-FOR
    option forwardfor
    # add X-CLIENT-IP
    http-request add-header X-CLIENT-IP %[src]
    server 10.18.200.109_8010 10.18.200.109:8010 check
    server 10.18.200.119_8010 10.18.200.119:8010 check backup
    #server 10.18.200.222_8010 10.18.200.222:8010 check
    
####### SSH - GITLAB.nexdev.net
backend ssh-proxy-backend
    mode tcp
    stick-table type ip size 200k expire 30m
    stick on src
    #server 10.18.200.222_2221 10.18.200.222:2221 check
    server 10.18.200.109_2221 10.18.200.109:2221 check
    server 10.18.200.119_2221 10.18.200.119:2221 check backup
####### SSH - GITLAB.nexdev.net
####### SMTP
backend smtp_cluster
    mode tcp
    no option http-server-close
    option smtpchk HELO smtp.nexdev.net
    server 10.18.200.250 10.18.200.250:10025 send-proxy check
    server 10.18.200.251 10.18.200.251:10026 send-proxy check backup
