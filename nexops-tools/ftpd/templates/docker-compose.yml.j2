version: "3.7"

services:
    ftpserver:
        image: registry.nexdev.net:5050/docker/nexops-tools/ftpd
        environment:
            PUBLICHOST: {{PUBLICHOST}} #10.18.200.133
        volumes:
            - "/var/www/gluster/nexops/ftpd/configs:/etc/pure-ftpd/passwd"
            - "/var/www/gluster/nexops/ftpd/data/olympus:/home/ftpusers/olympus"
        working_dir: /home/
        restart: always
        deploy:
          placement:
            constraints:
              - node.labels.FTPD == yes
        networks:
          - {{swarm_network_nexops}}
        ports:
            - "2121:21"
            - "30000-30009:30000-30009"
networks:
  {{swarm_network_nexops}}:
    external: true