version: "3.8"

services:
  web:
    image: sonarqube:8.4.2-community
    depends_on:
      - postgres
    networks:
      - swarm_nexcel_local
    healthcheck:
      test: wget -qO- http://localhost:9000/api/system/status || exit 1
      interval: 15s
      timeout: 5s
      retries: 10
    ports: 
      - 9009:9000
    deploy:
      mode: replicated
      replicas: 1
      #endpoint_mode: dnsrr
      placement:
        constraints:
          - "node.labels.{{node_label}}==yes"
        #max_replicas_per_node: 1
    stop_grace_period: 1m
    environment:
      SONAR_HOME: /opt/sonarqube
      SONAR_JDBC_USERNAME: sonar
      SONAR_JDBC_PASSWORD: SQL@Root1105
      SONAR_JDBC_URL: jdbc:postgresql://postgres/sonar
    volumes:
      - conf:/opt/sonarqube/conf
      - data:/opt/sonarqube/data
      - extensions:/opt/sonarqube/extensions
      - logs:/opt/sonarqube/logs

  postgres:
    image: postgres:9.6
    networks:
      - swarm_nexcel_local
    healthcheck:
      test: ["CMD", "pg_isready"]
      interval: 15s
      timeout: 5s
      retries: 5
    deploy:
      mode: replicated
      replicas: 1
      endpoint_mode: dnsrr
      placement:
        constraints:
          - "node.labels.{{node_label}}==yes"
    #    max_replicas_per_node: 1
    environment:
      POSTGRES_USER: sonar
      POSTGRES_PASSWORD: SQL@Root1105
      POSTGRES_DB: sonar
    volumes:
      - db_data:/var/lib/postgresql/data

networks:
  swarm_nexcel_local:
    external: true

volumes:
  conf:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: "{{web_folder}}/conf"
  data:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: "{{web_folder}}/data"
  extensions:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: "{{web_folder}}/extensions"
  logs:
  db_data:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: "{{postgres_folder}}"