filebeat.prospectors:
- input_type: log
  paths:
    - /var/www/log_haproxy/*.log
  document_type: haproxy_access
filebeat:
  spool_size: 1024
  idle_timeout: "5s"
  registry_file: /var/lib/filebeat/registry
output.logstash:
  hosts: ["logstash.nexdev.net:5000"]
logging:
  files:
    path: /var/log/mybeat
    name: mybeat
    rotateeverybytes: 10485760