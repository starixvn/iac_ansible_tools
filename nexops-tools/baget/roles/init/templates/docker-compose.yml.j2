Version: '3.5'
services:
  baget-server:
    image: loicsharma/baget:latest
    ports:
     - "5555:80"
    volumes:
     - ./baget-data:/var/baget
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.{{label_node | default ('NEXOPS_HIGH_STORAGE')}} == yes
    env_file:
     - baget.env
    networks:
     - '{{swarm_network_nexops}}'
networks:
  {{ swarm_network_nexops }}:
    external: true