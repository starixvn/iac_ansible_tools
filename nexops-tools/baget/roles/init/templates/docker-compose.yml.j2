version: '3.8'
services:
  baget-server:
    image: hub.nexdev.net/nexops/baget:latest
    ports:
     - "5555:80"
    volumes:
     - ./baget-data:/var/baget
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.{{label_node | default ('BAGET')}} == yes
    env_file:
     - baget.env
    networks:
     - '{{swarm_network_nexops}}'
networks:
  {{ swarm_network_nexops }}:
    external: true
  net:
    driver: overlay
    attachable: true
    ipam:
      config:
        - subnet: 172.177.0.0/24