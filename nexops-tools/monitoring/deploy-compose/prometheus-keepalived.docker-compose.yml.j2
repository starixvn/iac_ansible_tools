{% if env == "local" or env == "nexprod" or env == "aws" or env == "azure" %}
{% set hub_url = "hub.nexdev.net" %}
{% else %}
{% set hub_url = "nexhub.starixplay.com/kbt" %}
{% endif %}
########################################################################
# File managed by Ansible - NexOps
# Your changes will be overwritten.
#######################################################################
version: '3.3'

networks:
  swarm_{{org}}_{{env}}:
    external: true
  #net:
  #  driver: overlay
  #  attachable: true
  #  ipam:
  #    config:
  #      - subnet: 172.177.0.0/24

volumes:
  {{prometheus_volume | default ('prometheus_data')}}:
    driver_opts:
      o: bind
      type: none
      device: {{working_directory}}/prometheus/data
  
  {{alertmanager_volume | default ('alertmanager_data')}}:
    driver_opts:
      o: bind
      type: none
      device: {{working_directory}}/alertmanager/data

configs:
  prometheus_config:
    file: ./prometheus/prometheus.yml
  alertmanager_config:
    file: ./alertmanager/alertmanager.yml

services:
  prometheus:
    image: registry.nexdev.net:5050/docker/nexops-tools/prometheus:latest
    ports:
      - "{{prometheus_port | default ('9091')}}:9090"
    networks:
      #- net
      - swarm_{{org}}_{{env}}
    command:
#      - '--config.file=/etc/prometheus/prometheus_custom.yml'
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention=24h'
    volumes:
      - prometheus_data:/prometheus
    configs:
      - source: prometheus_config
        target: /etc/prometheus/prometheus.yml      
#        target: /etc/prometheus/prometheus_custom.yml
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.{{label_node | default ('NEXOPS_LOW_STORAGE')}} == yes
      resources:
        limits:
          memory: 2048M
        reservations:
          memory: 128M


  alertmanager:
    image: prom/alertmanager:latest
    ports:
      - "{{alertmanager_port | default ('9099')}}:9093"
    networks:
      - swarm_{{org}}_{{env}}
    volumes:
      - alertmanager_data:/etc/alertmanager
    configs:
      - source: alertmanager_config
        target: /etc/alertmanager/alertmanager.yml
    command:
      - '--config.file=/etc/alertmanager/alertmanager.yml'
      - '--storage.path=/alertmanager'
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.{{label_node | default ('NEXOPS_LOW_STORAGE')}} == yes
      resources:
        limits:
          memory: 2048M
        reservations:
          memory: 128M
    
