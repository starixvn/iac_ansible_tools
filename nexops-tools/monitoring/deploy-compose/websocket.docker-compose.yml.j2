version: '3.3'
networks:
  monitoring_net:
    external: true

services:
  netshoot:
    image: registry.nexdev.net:5050/docker/nexops-tools/websocket
    ports:
      - {{port | default ('8082')}}:8080
    networks:
      - monitoring_net
    deploy:
      mode: global
      resources:
        limits:
          memory: 200M
        reservations:
          memory: 64M
    command: ping localhost