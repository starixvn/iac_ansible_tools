#stefanprodan/swarmprom-prometheus:v2.5.0
version: "3.3"

networks:
  net:
    driver: overlay
    attachable: true
    ipam:
      config:
        - subnet: 172.177.0.0/24

volumes:
  grafana: {}
  mysql:
    driver_opts:
      o: bind
      type: none
      device: "{{working_directory}}/mysql"

services:
  grafana:
    image: registry.nexdev.net:5050/docker/nexops-tools/grafana:${ENV}
    networks:
      - net
    depends_on:
      - mysql
    environment:
      - GF_SECURITY_ADMIN_USER=${ADMIN_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${ADMIN_PASSWORD:-admin}
      - GF_USERS_ALLOW_SIGN_UP=false
      #- GF_INSTALL_PLUGINS=redis-datasource,alexanderzobnin-zabbix-app
      #- GF_INSTALL_PLUGINS=alexanderzobnin-zabbix-app
      #- GF_INSTALL_PLUGINS=grafana-clock-panel
      #- GF_AUTH_LDAP_ENABLED=false
      #- GF_AUTH_LDAP_CONFIG_FILE=/opt/pf-grafana/ldap.toml
      #- GF_SERVER_ROOT_URL=${GF_SERVER_ROOT_URL:-localhost}
      #- GF_SMTP_ENABLED=${GF_SMTP_ENABLED:-false}
      #- GF_SMTP_FROM_ADDRESS=${GF_SMTP_FROM_ADDRESS:-grafana@test.com}
      #- GF_SMTP_FROM_NAME=${GF_SMTP_FROM_NAME:-Grafana}
      #- GF_SMTP_HOST=${GF_SMTP_HOST:-smtp:25}
      #- GF_SMTP_USER=${GF_SMTP_USER}
      #- GF_SMTP_PASSWORD=${GF_SMTP_PASSWORD}
    volumes:
      - grafana:/var/lib/grafana
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000"]
      interval: 10s
      timeout: 5s
      retries: 60
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.NEXOPS_LOW_STORAGE == yes
      resources:
        limits:
          memory: 128M
        reservations:
          memory: 64M

  mysql:
    image: registry.nexdev.net:5050/docker/database/mysql:8.0
    networks:
      - net
    command: --default-authentication-plugin=mysql_native_password
    environment:
      - MYSQL_DATABASE=grafana
      - MYSQL_ROOT_PASSWORD=Ilu@n3xc3l
      - MYSQL_USER=grafana
      - MYSQL_PASSWORD=grafana
    volumes:
      - mysql:/var/lib/mysql
    healthcheck:
      test: out=$$(mysqladmin ping -h localhost -P 3306 -u root --password=Ilu@n3xc3l 2>&1); echo $$out | grep 'mysqld is alive' || { echo $$out; exit 1; }
      interval: 5s
      timeout: 20s
      retries: 30
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.NEXOPS_LOW_STORAGE == yes

  phpmyadmin:
    image: registry.nexdev.net:5050/docker/phpmyadmin:latest
    restart: always
    ports:
        - {{phpadmin_port | default ('8088')}}:80
    environment:
        MYSQL_USERNAME: grafana
        MYSQL_ROOT_PASSWORD: grafana
        PMA_HOSTS: mysql
    deploy:
        mode: replicated
        replicas: 1
        placement:
            constraints:
            - node.labels.{{node_label | default ('NEXOPS_LOW_STORAGE')}} == yes
    networks:
      - net