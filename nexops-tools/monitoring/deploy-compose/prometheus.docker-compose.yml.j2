version: '3.3'

networks:
  swarm_{{org}}_{{env}}:
    external: true
  net:
    driver: overlay
    attachable: true
    ipam:
      config:
        - subnet: 172.177.0.0/24

volumes:
  {{prometheus_volume | default ('prometheus_data')}}:
    driver_opts:
      o: bind
      type: none
      device: {{working_directory}}/prometheus/data

configs:
  caddy_config:
    file: ./caddy/Caddyfile
  prometheus_config:
    file: ./prometheus/prometheus.yml

services:
  cadvisor:
    image: registry.nexdev.net:5050/docker/nexops-tools/cadvisor
    networks:
      - net
    #command: -logtostderr -docker_only
    command: 
      #- '--docker=tcp://socket-proxy:2375'
      - '--housekeeping_interval=15s'
      - '--docker_only=true'
{% if enable_monitor_network is defined and enable_monitor_network == "yes" %}
      - '--disable_metrics=disk,tcp,udp,percpu,sched,process'
{% else %}
      - '--disable_metrics=disk,network,tcp,udp,percpu,sched,process'
{% endif %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /:/rootfs:ro
      - /var/run:/var/run
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
    deploy:
      mode: global
      resources:
        limits:
          memory: 128M
        reservations:
          memory: 64M
{% set node_id = "{{.Node.ID}}" %}
  node-exporter:
    image: registry.nexdev.net:5050/docker/nexops-tools/node-exporter
    networks:
      - net
    environment:
      - NODE_ID={{node_id}}
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
      - /etc/hostname:/etc/nodename
    command:
      - '--path.sysfs=/host/sys'
      - '--path.procfs=/host/proc'
      - '--collector.textfile.directory=/etc/node-exporter/'
      - '--collector.filesystem.ignored-mount-points=^/(sys|proc|dev|host|etc)($$|/)'
      - '--no-collector.ipvs'
    deploy:
      mode: global
      resources:
        limits:
          memory: 128M
        reservations:
          memory: 64M

  prometheus:
    image: registry.nexdev.net:5050/docker/nexops-tools/prometheus
    ports:
      - '9090:9090'
    networks:
      - net
      - swarm_{{org}}_{{env}}
    command:
      - '--config.file=/etc/prometheus/prometheus_custom.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention=3d'
    volumes:
      - prometheus_data:/prometheus
    configs:
      - source: prometheus_config
        target: /etc/prometheus/prometheus_custom.yml
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.{{label_node | default ('NEXOPS_LOW_STORAGE')}} == yes
      resources:
        limits:
          memory: 2048M
        reservations:
          memory: 128M

  caddy:
    image: registry.nexdev.net:5050/docker/nexops-tools/caddy
    ports:
      - '3000:3000'
      - '9092:9090'
      - '9093:9093'
      - '9094:9094'
    networks:
      - net
    environment:
      - ADMIN_USER=admin
      - ADMIN_PASSWORD=admin
    configs:
      - source: caddy_config
        target: /etc/caddy/Caddyfile
    deploy:
      mode: global
      placement:
        constraints:
          - node.labels.{{label_node | default ('NEXOPS_LOW_STORAGE')}} == yes
      resources:
        limits:
          memory: 128M
        reservations:
          memory: 64M

