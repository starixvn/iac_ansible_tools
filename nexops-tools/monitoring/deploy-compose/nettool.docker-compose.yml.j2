version: '3.3'
networks:
  monitoring_net:
    external: true

services:
  netshoot:
    image: registry.nexdev.net:5050/docker/nexops-tools/netshoot
    networks:
      - monitoring_net
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    deploy:
      mode: global
      resources:
        limits:
          memory: 200M
        reservations:
          memory: 64M
    command: ping localhost