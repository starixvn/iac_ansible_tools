global:
route:
  group_by: ['alertname']
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 1m
  receiver: telegram
  routes:
  - receiver: telegram
    matchers:
    - severity="critical"


receivers:
- name: 'telegram'
  telegram_configs:
  - bot_token: "{{ bot_token }}"
    chat_id: {{ chat_id }}
    api_url: https://api.telegram.org
    parse_mode: "HTML"
    http_config:
      proxy_url: "http://10.2.252.100:8801"
templates:
- /etc/alertmanager/alert-message.tmpl
