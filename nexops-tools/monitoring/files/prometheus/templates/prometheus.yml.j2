global:
  scrape_interval: 15s
  evaluation_interval: 15s

  external_labels:
    monitor: 'promswarm'

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'dockerd-exporter'
    dns_sd_configs:
      - names:
          - 'tasks.dockerd-exporter'
        type: 'A'
        port: 9323

  - job_name: 'cadvisor'
    dns_sd_configs:
      - names:
          - 'tasks.cadvisor'
        type: 'A'
        port: 8080

  - job_name: 'node-exporter'
    dns_sd_configs:
      - names:
          - 'tasks.node-exporter'
        type: 'A'
        port: 9100        
{%if haproxys is defined%}
{% for haproxy in haproxys %}
  - job_name: '{{haproxy.name}}'
    scrape_interval: '{{scrape_interval}}'
    metrics_path: '{{haproxy.metric}}'
    static_configs:
      - targets: ['{{haproxy.url}}']
        labels:
            service: '{{haproxy.name}}'
{% endfor %}
{%endif%}
{%if jobs is defined%}
{% for job in jobs %}
  - job_name: '{{job.name}}'
    scrape_interval: '{{scrape_interval}}'
    metrics_path: '{{job.metric}}'
    params:
      secretKey: ['{{job.token}}']
    static_configs:
      - targets: ['{{job.url}}']
        labels:
            service: '{{job.name}}'
{% endfor %}
{%endif%}