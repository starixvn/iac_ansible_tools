global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - 'keepalived.rules'

alerting:
  alertmanagers:
  - scheme: http
    static_configs:
    - targets:
      - "alertmanager:9099"


scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

{%if keepaliveds is defined%}
{%for keepalived in keepaliveds%}
  - job_name: '{{keepalived.name}}'
    scrape_interval: 5s
    #scrape_timeouts: 5s
    metrics_path: '{{keepalived.metric}}'
    scheme: '{{keepalived.scheme}}'
    static_configs:
      - targets: ['{{keepalived.url}}']
        labels:
            service: '{{keepalived.service}}'
{%endfor%}
{%endif%}
