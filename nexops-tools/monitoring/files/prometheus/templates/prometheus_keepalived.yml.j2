global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - alert.yml

alerting:
  alertmanagers:
  - scheme: http
    static_configs:
    - targets:
      - "alertmanager:9093"


scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: {{ lookup('vars', org +'_keepaliveds_' + env).name}}
    scrape_interval: 5s
    metrics_path: {{ lookup('vars', org +'_keepaliveds_' + env).metric}}
    scheme: {{ lookup('vars', org +'_keepaliveds_' + env).scheme}}
    static_configs:
      - targets: {{ lookup('vars', org +'_keepaliveds_' + env).targets}}
        labels:
          service: {{ lookup('vars', org +'_keepaliveds_' + env).service}}

  - job_name: 'node-exporter'
    dns_sd_configs:
      - names: 
          - 'tasks.node-exporter'
        type: 'A'
        port: 9100
