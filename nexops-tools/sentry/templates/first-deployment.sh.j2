#!/usr/bin/env bash

#docker stack deploy -c docker-compose.yml sentry
docker service scale {{stack}}_clean_{{org}}=0 {{stack}}_web_{{org}}=0 {{stack}}_cron_{{org}}=0 {{stack}}_worker_{{org}}=0 

until docker service ps --filter desired-state=running {{stack}}_postgres_{{org}} 2>&1 >> /dev/null
do
    echo "wait {{stack}}_postgres_{{org}} up..."
    sleep 1
done

cat init.sql | docker exec -i $(./postgres-container-id.sh) psql -U postgres

docker service scale {{stack}}_web_{{org}}=1 {{stack}}_cron_{{org}}=1 {{stack}}_worker_{{org}}=1 {{stack}}_clean_{{org}}=1 

until docker service ps --filter desired-state=running {{stack}}_web_{{org}} 2>&1 >> /dev/null
do
    echo "wait {{stack}}_web_{{org}} up..."
    sleep 1
done