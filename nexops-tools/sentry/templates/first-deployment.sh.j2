#!/usr/bin/env bash

#docker stack deploy -c docker-compose.yml sentry
docker service scale sentry_clean_{{org}}=0 sentry_web_{{org}}=0 sentry_cron_{{org}}=0 sentry_worker_{{org}}=0 

until docker service ps --filter desired-state=running sentry_postgres_{{org}} 2>&1 >> /dev/null
do
    echo "wait sentry_postgres_{{org}} up..."
    sleep 3
done

#cat init.sql | docker exec -i $(./postgres-container-id.sh) psql -U postgres

docker service scale sentry_web_{{org}}=1 sentry_cron_{{org}}=1 sentry_worker_{{org}}=1 sentry_clean_{{org}}=1 

until docker service ps --filter desired-state=running sentry_web_{{org}} 2>&1 >> /dev/null
do
    echo "wait sentry_sentry up..."
    sleep 3
done