version: "3.8"
services:
  prometheus-windows:
    image: prom/prometheus
    ports:
      - "9091:9090"
    networks:
      - '{{swarm_network_nexops}}'   
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.prometheus-windows == dummy

networks:
  {{ swarm_network_nexops }}:
    external: true