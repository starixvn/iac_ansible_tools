version: "3.8"
services:
  prometheus:
    image: stefanscherer/prometheus-windows:latest
    ports:
      - "9091:9090"
    networks:
      - '{{swarm_network_nexops}}'   
    #volumes:
      #- ./prometheus.yml:/etc/prometheus/prometheus.yml
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.{{label_node | default ('prometheus-windows')}} == yes

networks:
  {{ swarm_network_nexops }}:
    external: true