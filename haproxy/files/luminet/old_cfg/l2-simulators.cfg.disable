
frontend l2_gamelobby_simulator
    bind *:6410
    mode  http
    option forwardfor
    default_backend l2_gamelobby_simulator_nodes

backend l2_gamelobby_simulator_nodes
    option forwardfor
    option http-server-close
    option httpchk GET /
    http-check expect status 200
    cookie serverid insert
    server-template l2_game_lobby_simulator_SIT_ 1 l2_game_lobby_simulator_SIT:5000 check resolvers docker init-addr libc,none

frontend l2_owapi_simulator
    bind *:6411
    mode  http
    option forwardfor
    default_backend l2_owapi_simulator_nodes

backend l2_owapi_simulator_nodes
    option forwardfor
    option http-server-close
    option httpchk GET /healthcheck
    http-check expect status 200
    cookie serverid insert
    server-template l2_ow_api_simulator_SIT_ 1 l2_ow_api_simulator_SIT:5000 check resolvers docker init-addr libc,none
