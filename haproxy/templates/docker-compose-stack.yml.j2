version: '3.5'

services:
  service:
    image: {{haproxy_image_name}}:{{haproxy_version}}
    volumes:
      - data:{{image_config_path}}
    ports:
{% for port in lookup('vars', team + '_ports_' + env) %}
      - published: {{port.published}}
        target: {{port.target}}
        mode: {{port.mode}}
{% endfor %}

    dns:
      - 127.0.0.11
    networks:
      - {{swarm_network_name}}
{% for version in range(1,3) %}
      - {{swarm_network_name}}_{{version}}:
{% endfor %}
    deploy:
        mode: global
        placement:
          constraints: 
            - node.labels.HAPROXY == yes

networks:
  {{swarm_network_name}}:
     external: true
{% for version in 1..3 %}
  {{swarm_network_name}}_{{version}}:
     external: true
{% endfor %}

volumes:
  data:
    driver: local
    driver_opts:
       o: bind
       type: none
       device: {{volume_path}}