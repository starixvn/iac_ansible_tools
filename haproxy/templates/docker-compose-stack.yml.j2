version: '3.5'

services:
  service:
    image: {{haproxy_image_name}}:{{haproxy_version}}
    volumes:
      - data:{{image_config_path}}
{% if enable_port is undefined or enable_port == true %}
    ports:
{% for port in lookup('vars', team + '_ports_' + env) %}
      - published: {{port.published}}
        target: {{port.target}}
        mode: {{port.mode}}
{% endfor %}
{% endif %}
    dns:
      - 127.0.0.11
    networks:
{% for swarm_network in swarm_networks %}
      - {{swarm_network}}
{% endfor %}
      - {{swarm_network_nexops}}
    deploy:
        mode: global
        placement:
          constraints: 
            - node.labels.HAPROXY == yes
    healthcheck:
      test: ['CMD', 'curl', '-f', "http://localhost:80/stats"]
      interval: 30s
      timeout: 5s
      retries: 20

networks:
{% for swarm_network in swarm_networks %}
  {{swarm_network}}:
    external: true
{% endfor %}
  {{swarm_network_nexops}}:
    external: true

volumes:
  data:
    driver: local
    driver_opts:
       o: bind
       type: none
       device: {{volume_path}}