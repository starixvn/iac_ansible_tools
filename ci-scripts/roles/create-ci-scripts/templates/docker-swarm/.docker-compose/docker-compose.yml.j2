########################################################################
# File managed by Ansible - NexOps
# Your changes will be overwritten.
#######################################################################
{% set service_name = item.0.name | replace('-','_') %}
{% set underscore = '' if item.1 == 0  else '_' %}
{% set environment_version = '' if item.1 == 0  else item.1 %}
{% set environment = env | upper ~ underscore ~ environment_version %}
{% set working_path = gluster_path ~ team_name ~ '/' ~ project_name ~ '/' ~ item.0.name | replace('-','_') %}
{% set config_file_path = item.0.config_file_path | default(".") %}
{% if item.0.config_file_name is defined %}
{% set config_file = item.0.config_file_name ~ '.' ~ item.0.config_file_ext %}
{% endif %}
{% set config_container_path = item.0.config_container_path | default ('.') %}
{% set container_root_path = item.0.container_root_path | default ('/app') %}
{% if item.0.sp_mapper is defined and item.0.sp_mapper == true %}
{% set sp_file = item.0.sp_file_name | default("SpNames") ~ '.' ~ item.0.sp_file_extension | default("xml") %}
{% endif %}
{% set storage_label = '_LOW_STORAGE' if high_storage is undefined or high_storage == false else '_HIGH_STORAGE'%}
{% set org_node_label = org_name ~ storage_label %}
{% set network = org_name | lower ~ '_' ~ env | lower %}

version: '3.3'
{% if config_file is defined %}
configs:
  {{service_name}}_{{ environment }}_config:
    file: {{working_path}}/{{environment}}/configs/{{config_file}}
{% if sp_file is defined %}
  {{service_name}}_{{ environment }}_sp_config:
    file: {{working_path}}/{{environment}}/configs/{{sp_file}}
{% endif %}
{% endif %}

services:
  {{service_name}}_{{environment}}:
{% if gitlab_url == "git3.nexdev.net" %}
    image: git3.nexdev.net:5050/{{item.0.docker_image_registry_path}}:{{environment}}-latest
{% else %}
    image: registry.nexdev.net:5050/{{item.0.docker_image_registry_path}}:{{environment}}-latest
{% endif %}
{% if config_file is defined %}
    configs:
      - source: {{service_name}}_{{ environment }}_config
        target: {{container_root_path}}/{{config_container_path}}/{{config_file}}
{% if sp_file is defined %}
      - source: {{service_name}}_{{ environment }}_sp_config
        target: {{container_root_path}}/App_Data/{{sp_file}}
{% endif %}
{% endif %}
{% if item.0.volumes is defined %}
    volumes:
{% for volume in item.0.volumes %}
      - {{gluster_path}}{{volume.src}}/{{environment}}:{{volume.dest}}
{% endfor %}
{% endif %}
    deploy:
      mode: replicated
      replicas: {{item.0.number_of_replicas | default('1') }}
      endpoint_mode: dnsrr
      placement:
        constraints:
          - node.labels.{{ org_node_label | upper }} == yes
{% if item.0.node_labels is defined %}
{% for node_label in item.0.node_labels %}
          - node.labels.{{ node_label | upper }} == yes
{% endfor %}
{% endif %}
    networks:
      - swarm_{{ network }}
{% if item.0.framework is defined and item.0.framework == "dotnet" %}
    healthcheck:
      test: ['CMD', 'curl', '-f', "http://localhost:{{item.0.port | default('5000')}}{{item.0.healthcheck_path | default('')}}"]
      interval: 5s
      timeout: 5s
      retries: 5
{% endif %}
    labels:
      # - "io.portainer.accesscontrol.public"
      - "io.portainer.accesscontrol.teams={{team_name}}"
networks:
  swarm_{{ network }}:
    external: true