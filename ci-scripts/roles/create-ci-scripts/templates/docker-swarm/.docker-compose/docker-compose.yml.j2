version: '3.3'
services:
  {{item.name}}_{{ env | upper }}:
    image: registry.nexdev.net:5050/{{item.docker_image_registry_path}}
{% if item.volumes is defined or item.config_file_path is defined %}
    volumes:
{% if item.framework is defined and item.framework == "dotnet" %}
      - /var/www/gluster/web/{{team_name}}/{{project_name}}/{{item.name | replace('-','_') }}/configs/appsettings.json:/app/appsettings.json
{% endif %}
{% if item.volumes is defined %}
{% for volume in item.volumes %}
      - /var/www/gluster/web/{{volume.src}}:{{volume.dest}}
{% endfor %}
{% endif %}
{% endif %}
    deploy:
      mode: replicated
      replicas: {{item.number_of_replicas | default('1') }}
      endpoint_mode: dnsrr
      placement:
        constraints:
          - node.labels.{{ org_name | upper }} == yes
{% if item.node_labels is defined %}
{% for node_label in item.node_labels %}
          - node.labels.{{ node_label | upper }} == yes
{% endfor %}
{% endif %}
    networks:
      - swarm_{{ org_name | lower }}_{{ env | lower }}
networks:
  swarm_{{ org_name | lower }}_{{ env | lower }}:
    external: true
