########################################################################
# File managed by Ansible - NexOps
# Your changes will be overwritten.
#######################################################################
{% set environment = '{{ env | upper }}{{ '' if item.1 == 0  else '_' }}{{'' if item.1 == 0  else item.1 }}' %}
{% set working_path = '/var/www/gluster/web/{{team_name}}/{{project_name}}/{{item.0.name | replace('-','_')}}'%}
version: '3.3'
services:
  {{item.0.name}}_{{environment}}:
{% if gitlab_url == "git3.nexdev.net" %}
    image: git3.nexdev.net:5050/{{item.0.docker_image_registry_path}}:{{environment}}-latest
{% else %}
    image: registry.nexdev.net:5050/{{item.0.docker_image_registry_path}}:{{environment}}-latest
{% endif %}
{% if item.0.volumes is defined or item.0.config_file_path is defined %}
    volumes:
{% if item.0.framework is defined and item.0.framework == "dotnet" %}
      - {{working_path}}/{{environment}}/configs/{{item.0.config_file_name | default("appsettings")}}.{{item.0.config_file_ext | default("json")}}:{{ item.0.config_container_path | default ('/app')}}/{{item.0.config_file_name | default("appsettings")}}.{{item.0.config_file_ext | default("json")}}
{% if  item.0.sp_mapper is defined and item.0.sp_mapper == true %}
      - {{working_path}}/{{environment}}/configs/{{item.0.sp_file_name | default("SpNames")}}.{{item.0.sp_file_extension | default("xml")}}:{{ item.0.sp_container_path | default ('/app')}}/App_Data/{{item.0.sp_file_name | default("SpNames")}}.{{item.0.sp_file_extension | default("xml")}}
{% endif %}
{% elif item.0.config_file_name is defined %}
    - {{working_path}}/{{environment}}/{{item.0.config_file_name}}.{{item.0.config_file_ext}}:{{item.0.config_container_path }}/{{item.0.config_file_name}}.{{item.0.config_file_ext}}
{% endif %}
{% if item.0.volumes is defined %}
{% for volume in item.0.volumes %}
      - /var/www/gluster/web/{{volume.src}}/{{environment}}:{{volume.dest}}
{% endfor %}
{% endif %}
{% endif %}
    deploy:
      mode: replicated
      replicas: {{item.0.number_of_replicas | default('1') }}
      endpoint_mode: dnsrr
      placement:
        constraints:
          - node.labels.{{ org_name | upper }} == yes
{% if item.0.node_labels is defined %}
{% for node_label in item.0.node_labels %}
          - node.labels.{{ node_label | upper }} == yes
{% endfor %}
{% endif %}
    networks:
      - swarm_{{ org_name | lower }}_{{ env | lower }}
networks:
  swarm_{{ org_name | lower }}_{{ env | lower }}:
    external: true
