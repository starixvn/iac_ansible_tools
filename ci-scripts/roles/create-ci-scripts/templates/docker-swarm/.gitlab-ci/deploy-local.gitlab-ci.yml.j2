post_build_{{item.name}}_local:
  extends:
    - .deploy_vars_{{item.name}}
    - .post_build
    - .deploy:local
    - .deploy:local:{{item.name}}:rules
  needs: ['build_image_{{item.name}}']

deploy_{{item.name}}_local:
  extends:
    - .deploy_vars_{{item.name}}
    - .deploy:local:base:swarm
    - .deploy:local:{{item.name}}:rules
  needs: ['post_build_{{item.name}}_local']
  