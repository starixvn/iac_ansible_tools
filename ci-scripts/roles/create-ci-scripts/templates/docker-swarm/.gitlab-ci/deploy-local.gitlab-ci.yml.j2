{% set service_name = item.name | replace('-','_') %}

{% for version in versions %}
{% set version_number = '' if version == 0 else version %}
post_build_{{service_name}}_local{{ version_number }}:
  extends:
    - .deploy_vars_{{service_name}}
    - .post_build
    - .deploy:local{{ version_number }}
    - .deploy:local{{ version_number }}:{{service_name}}:rules
{% if item.multiple_image_env is undefined or item.multiple_image_env == false %}
  needs: ['scan_image_{{service_name}}','build_image_{{service_name}}']
{% else %}
  needs: ['scan_image_{{service_name}}_local{{ version_number }}','build_image_{{service_name}}_local{{ version_number }}']
{% endif %}

deploy_{{service_name}}_local{{ version_number }}:
  extends:
    - .deploy_vars_{{service_name}}
    - .deploy:local{{ version_number }}:base:swarm:stack
    - .deploy:local{{ version_number }}:{{service_name}}:rules
  needs: ['post_build_{{service_name}}_local{{ version_number }}']

{% endfor %}