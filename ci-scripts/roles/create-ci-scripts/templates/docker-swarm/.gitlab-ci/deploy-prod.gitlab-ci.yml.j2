post_build_{{item.name | replace('-','_') }}_prod:
  extends:
    - .deploy_vars_{{item.name | replace('-','_') }}
    - .post_build
    - .deploy:prod
    - .deploy:prod:{{item.name | replace('-','_') }}:rules
  needs: ['build_image_{{item.name | replace('-','_') }}']

deploy_{{item.name | replace('-','_') }}_prod:
  extends:
    - .deploy_vars_{{item.name | replace('-','_') }}
    - .deploy:prod:base:swarm
    - .deploy:prod:{{item.name | replace('-','_') }}:rules
  needs: ['post_build_{{item.name | replace('-','_') }}_prod']
{% if item.stack_deploy is undefined or item.stack_deploy == false %}
  variables:
    SWARM_REPLICAS: {{item.number_of_replicas | default ('1')}}
    NODE_LABEL: {{item.node_label}}
{%endif%}