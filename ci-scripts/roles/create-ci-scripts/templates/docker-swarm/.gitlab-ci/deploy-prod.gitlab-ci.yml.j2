{% set service_name = item.name | replace('-','_') %}

{% for version in versions %}
{% set version_number = '' if version == 0 else version %}
{% if org_name != 'luminet' %}
post_build_{{service_name}}_prod{{ version_number }}:
  extends:
    - .deploy_vars_{{service_name}}
    - .post_build
    - .deploy:prod{{ version_number }}
    - .deploy:prod{{ version_number }}:{{service_name}}:rules
{% if item.multiple_image_env is undefined or item.multiple_image_env == false %}  
  needs: ['build_image_{{service_name}}']
{% else %}
  needs: ['build_image_{{service_name}}_prod{{ version_number }}']
{% endif %}

deploy_{{service_name}}_prod{{ version_number }}:
  extends:
    - .deploy_vars_{{service_name}}
    - .deploy:prod{{ version_number }}:base:swarm:stack
    - .deploy:prod{{ version_number }}:{{service_name}}:rules
  needs: ['post_build_{{service_name}}_prod{{ version_number }}']

{% endif %}
{% endfor %}

{% if org_name == 'luminet' %}
post_build_{{service_name}}_prod:
  extends:
    - .deploy_vars_{{service_name}}
    - .post_build
    - .deploy:prod
    - .deploy:prod:{{service_name}}:rules
{% if item.multiple_image_env is undefined or item.multiple_image_env == false %}  
  needs: ['build_image_{{service_name}}']
{% else %}
  needs: ['build_image_{{service_name}}_prod']
{% endif %}

deploy_{{service_name}}_prod:
  extends:
    - .deploy_vars_{{service_name}}
    - .deploy:prod:base:swarm:stack
    - .deploy:prod:{{service_name}}:rules
  needs: ['post_build_{{service_name}}_prod']

{% endif %}