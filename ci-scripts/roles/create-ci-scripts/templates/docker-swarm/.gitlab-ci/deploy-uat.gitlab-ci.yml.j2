{% set service_name = item.name | replace('-','_') %}

{% for version in versions %}
post_build_{{service_name}}_uat{{ '' if version == 0 else version }}:
  extends:
    - .deploy_vars_{{service_name}}
    - .post_build
    - .deploy:uat{{ '' if version == 0 else version }}
    - .deploy:uat{{ '' if version == 0 else version }}:{{service_name}}:rules
  needs: ['build_image_{{service_name}}']

deploy_{{service_name}}_uat{{ '' if version == 0 else version }}:
  extends:
    - .deploy_vars_{{service_name}}
    - .deploy:uat{{ '' if version == 0 else version }}:base:swarm:stack
    - .deploy:uat{{ '' if version == 0 else version }}:{{service_name}}:rules
  needs: ['post_build_{{service_name}}_uat{{ '' if version == 0 else version }}']

{% endfor %}