{% if item.config_file_name is defined %}
{% set config_file = item.config_file_name ~ '.' ~ item.config_file_ext %}
{% endif %}
{% set config_file_path = item.config_file_path | default(".") %}
{% set config_dest_file_path = item.config_dest_file_path | default(".") %}
{% set service_name = item.name | replace('-','_') %}

.base_build_cocos_web:
  stage: build-cocos-web
  extends:
    - .build:image:{{item.name | replace('-','_') }}:rules
  script:
    - echo "====== Build Cocos Web Mobile ======"
    - echo $DEPLOY_ENV
    - npm i
{% if config_file is defined %}
    - cp {{config_file_path}}/{{item.config_file_name}}.$DEPLOY_ENV.{{item.config_file_ext}} {{config_dest_file_path}}/{{config_file}}
{%endif%}
{% if item.cocos_version == "2.2.2" %}
    - /Applications/CocosCreator.app/Contents/MacOS/CocosCreator --path ./ --build "platform=web-mobile;inlineSpriteFrames=true;webOrientation=landscape;md5Cache=true"
{% else %}
    - /Applications/CocosCreator/Creator/{{item.cocos_version | default(2.4.0)}}/CocosCreator.app/Contents/MacOS/CocosCreator --path ./ --build "platform=web-mobile;inlineSpriteFrames=true;webOrientation=landscape;md5Cache=true"
{%endif%}
  tags:
    - cocos
  artifacts:
    paths:
      - ./build/web-mobile
    expire_in: 1 day

{% if config_file is undefined %}
build_cocos_web:
  extends: .base_build_cocos_web
{% else %}
{% for version in versions %}
{% set version_number = '' if version == 0 else version %}
build_cocos_web_local{{ version_number }}:
  extends: 
    - .base_build_cocos_web
    - .deploy:local{{ version_number }}
    - .deploy:local{{ version_number }}:{{service_name}}:rules

build_cocos_web_sit{{ version_number }}:
  extends: 
    - .base_build_cocos_web
    - .deploy:sit{{ version_number }}
    - .deploy:sit{{ version_number }}:{{service_name}}:rules

build_cocos_web_uat{{ version_number }}:
  extends: 
    - .base_build_cocos_web
    - .deploy:uat{{ version_number }}
    - .deploy:uat{{ version_number }}:{{service_name}}:rules

{% if org_name == 'luminet' and version == 0 %}
build_cocos_web_prod{{ version_number }}:
  extends: 
    - .base_build_cocos_web
    - .deploy:prod{{ version_number }}
    - .deploy:prod{{ version_number }}:{{service_name}}:rules
{% else %}}
build_cocos_web_prod{{ version_number }}:
  extends: 
    - .base_build_cocos_web
    - .deploy:prod{{ version_number }}
    - .deploy:prod{{ version_number }}:{{service_name}}:rules
{%endif%}
{% endfor %}
{%endif%}

