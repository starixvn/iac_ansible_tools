{% if item.config_file_name is defined %}
{% set config_file = item.config_file_name ~ '.' ~ item.config_file_ext %}
{% endif %}
{% set config_file_path = item.config_file_path | default(".") %}
{% set config_dest_file_path = item.config_dest_file_path | default(".") %}
{% set service_name = project_name ~ '_' ~ item.name | replace('-','_') %}

.base_transform_config_{{ service_name }}:
  stage: transform-config
  extends:
    - .build:image:{{ service_name }}:rules
  script:
    - echo "====== Build NextJS ======"
    - echo $DEPLOY_ENV
    - cp {{config_file_path}}/{{item.config_file_name}}.$DEPLOY_ENV.{{item.config_file_ext}} {{config_dest_file_path}}/{{config_file}}
  tags:
    - docker
  artifacts:
    paths:
      - ./{{config_dest_file_path}}/{{config_file}}
    expire_in: 1 day

transform_config_{{ service_name }}_local:
  extends: 
    - .base_transform_config_{{ service_name }}
    - .env:local
    - .deploy:local:{{service_name}}:rules

{% if team_name != "nex3" and team_name != "pentagon" %}
transform_config_{{ service_name }}_nexprod:
  extends: 
    - .base_transform_config_{{ service_name }}
    - .env:nexprod
    - .deploy:nexprod:{{service_name}}:rules

transform_config_{{ service_name }}_nexaws:
  extends: 
    - .base_transform_config_{{ service_name }}
    - .env:nexaws
    - .deploy:nexaws:{{service_name}}:rules

transform_config_{{ service_name }}_gc:
  extends: 
    - .base_transform_config_{{ service_name }}
    - .env:gc
    - .deploy:gc:{{service_name}}:rules

transform_config_{{ service_name }}_alphaprod:
  extends: 
    - .base_transform_config_{{ service_name }}
    - .env:alphaprod
    - .deploy:alphaprod:{{service_name}}:rules

transform_config_{{ service_name }}_fpsprod:
  extends: 
    - .base_transform_config_{{ service_name }}
    - .env:fpsprod
    - .deploy:fpsprod:{{service_name}}:rules

{% endif %}

transform_config_{{ service_name }}_sit:
  extends: 
    - .base_transform_config_{{ service_name }}
    - .env:sit
    - .deploy:sit:{{service_name}}:rules

transform_config_{{ service_name }}_uat:
  extends: 
    - .base_transform_config_{{ service_name }}
    - .env:uat
    - .deploy:uat:{{service_name}}:rules

transform_config_{{ service_name }}_prod:
  extends: 
    - .base_transform_config_{{ service_name }}
    - .env:prod
    - .deploy:prod:{{service_name}}:rules

transform_config_{{ service_name }}_aws:
  extends: 
    - .base_transform_config_{{ service_name }}
    - .env:aws
    - .deploy:aws:{{service_name}}:rules
