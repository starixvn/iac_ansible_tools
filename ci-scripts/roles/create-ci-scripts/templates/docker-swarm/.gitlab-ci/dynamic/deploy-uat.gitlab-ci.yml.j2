{% set service_name = item.name | replace('-','_') %}

{% if item.platform is undefined or item.platform == "linux" %}
post_build_{{service_name}}_uat:
  extends:
    - .deploy_vars_{{service_name}}
    - .post_build
    - .env:uat
    - .deploy:uat:{{service_name}}:rules
{% if item.multiple_image_env is undefined or item.multiple_image_env == false %}
  needs: ['scan_image_{{service_name}}']
{% else %}
  needs: ['scan_image_{{service_name}}_uat']
{% endif %}
{% endif %}

deploy_{{service_name}}_uat:
  extends:
    - .deploy_vars_{{service_name}}
    - .deploy:uat:base:swarm:stack
    - .deploy:uat:{{service_name}}:rules
{% if item.platform is undefined or item.platform == "linux" %}
  needs: ['post_build_{{service_name}}_uat']
{% else %}
  needs: ['build_image_{{service_name}}_uat']
{% endif %}
