{% set service_name = item.name | replace('-','_') %}

{% if item.multiple_image_env is undefined or item.multiple_image_env == false %}  

build_image_{{ service_name }}:
  extends:
    - .deploy_vars_{{ service_name }}
{% if item.multi_stage is undefined or item.multi_stage == false %}  
    - .build:default:image:noenv
{% else %}
    - .build:default:image:noenv:multistage
{% endif %}
    - .build:image:{{ service_name }}:rules
{% if item.framework is defined and item.framework == "cocos" %}  
  needs: ['build_cocos_web']
  dependencies:
    - build_cocos_web
{% endif %}

{% else %}

{% for version in versions %}
{% set version_number = '' if version == 0 else version %}
build_image_{{ service_name }}_local{{ version_number }}:
  extends:
    - .deploy_vars_{{ service_name }}
{% if item.multi_stage is undefined or item.multi_stage == false %}
    - .build:default:image
{% else %}
    - .build:default:image:multistage
{% endif %}
    - .deploy:local{{ version_number }}
    - .deploy:local{{ version_number }}:{{service_name}}:rules
{% if item.framework is defined and item.framework == "cocos" %}  
  needs: ['build_cocos_web_local{{ version_number }}']
  dependencies:
    - build_cocos_web_local{{ version_number }}
{% endif %}
{% if transform_config is defined and transform_config == true %}  
  needs: ['transform_config_local{{ version_number }}']
  dependencies:
    - transform_config_local{{ version_number }}
{% endif %}

