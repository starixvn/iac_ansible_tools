{% set service_name = project_name ~ '_' ~ item.name | replace('-','_') %}
{% set base_image = "image" if item.platform is undefined or item.platform == "linux" else "windowsimage" %}

{% if (item.multiple_image_env is undefined or item.multiple_image_env == false) and (item.platform is undefined or item.platform == "linux") %}

build_image_{{ service_name }}:
  extends:
    - .deploy_vars_{{ service_name }}
{% if item.multi_stage is undefined or item.multi_stage == false %}  
    - .build:default:image:noenv
{% else %}
    - .build:default:image:noenv:multistage
{% endif %}
    - .build:image:{{ service_name }}:rules
{% if item.framework is defined and item.framework == "cocos" %}  
  needs: ['build_cocos_web_{{ service_name }}']
  dependencies:
    - build_cocos_web_{{ service_name }}
{% endif %}
{% if transform_config is defined and transform_config == true %}  
  needs: ['transform_config_{{ service_name }}_local']
  dependencies:
    - transform_config_{{ service_name }}_local
{% endif %}
{% else %}

build_image_{{ service_name }}_local:
  extends:
    - .deploy_vars_{{ service_name }}
{% if item.multi_stage is undefined or item.multi_stage == false %}
    - .build:default:{{base_image}}
{% else %}
    - .build:default:{{base_image}}:multistage
{% endif %}
    - .env:local
    - .deploy:local:{{service_name}}:rules
{% if item.framework is defined and item.framework == "cocos" %}
  needs: ['build_cocos_web_{{ service_name }}_local']
  dependencies:
    - build_cocos_web_{{ service_name }}_local
{% endif %}
{% if transform_config is defined and transform_config == true %}
  needs: ['transform_config_{{ service_name }}_local']
  dependencies:
    - transform_config_{{ service_name }}_local
{% endif %}
