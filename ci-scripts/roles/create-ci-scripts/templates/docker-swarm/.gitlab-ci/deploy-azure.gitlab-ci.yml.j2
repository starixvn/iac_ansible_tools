{% set service_name = project_name ~ '_' ~ item.name | replace('-','_') %}

{% if item.platform is undefined or item.platform == "linux" %}
post_build_{{service_name}}_azure:
  extends:
    - .deploy_vars_{{service_name}}
    - .post_build
    - .env:azure
    - .deploy:azure:{{service_name}}:rules
{% if item.multiple_image_env is undefined or item.multiple_image_env == false %}
  needs: ['scan_image_{{service_name}}']
{% else %}
  needs: ['scan_image_{{service_name}}_azure']
{% endif %}
{% endif %}

deploy_{{service_name}}_azure:
  extends:
    - .deploy_vars_{{service_name}}
    - .deploy:azure:base:swarm:stack
    - .deploy:azure:{{service_name}}:rules
{% if item.platform is undefined or item.platform == "linux" %}
  needs: ['post_build_{{service_name}}_azure']
{% else %}
  needs: ['build_image_{{service_name}}_azure']
{% endif %}
