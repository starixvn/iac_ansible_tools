
.deploy_vars_{{item.name}}:
  variables:
    PROJECT_ROOT_PATH: {{item.root_path | default(".")}}
    WORKING_PATH: /var/www/gluster/web/{{team_name}}/{{project_name}}/{{item.name | replace('-','_') }}
    SERVICE_NAME: {{project_name}}_{{item.name | replace('-','_') }}
    DOCKER_IMAGE_PATH: {{item.docker_image_registry_path}}
    DOCKER_FILE_PATH: {{item.docker_file_path | default(".")}}
    DOCKER_FILE_NAME: {{item.docker_file_name | default("Dockerfile")}}
    CONFIG_FILE_PATH: {{item.config_file_path | default(".")}}
{% if  item.framework is defined and item.framework == "dotnet" %}
    SP_FILE_PATH: {{item.sp_file_path | default(".")}}/App_Data
    SP_FILE_NAME: {{item.sp_file_name | default("SpNames")}}
    SP_FILE_EXTENSION: {{item.sp_file_extension | default("xml")}}
    CONFIG_FILE_NAME: appsettings
    CONFIG_FILE: json
    CONFIG_CONTAINER_PATH: /app/appsettings.json
{%endif%}
    STACK_NAME: {{project_name}}
    DOCKER_COMPOSE_FILE_PATH: {{item.docker_compose_file_path | default(".")}}
    DOCKER_COMPOSE_REPO_PATH: .docker-compose/{{ item.name }}