{% set service_name = item.name | replace('-','_') %}
{% set platform = item.platform | default('linux') %}
{% set separator_char = '/' if platform == "linux" else '\\' %}
{% if item.config_file_name is defined %}
{% if item.config_file_ext | length > 0 %}
{% set config_file = item.config_file_name ~ '.' ~ item.config_file_ext %}
{% else %}
{% set config_file = item.config_file_name %}
{% endif %}
{% endif %}
.deploy_vars_{{project_name ~ '_' ~ service_name}}:
  variables:
    PROJECT_ROOT_PATH: {{item.root_path | default(".")}}
    WORKING_PATH: /var/www/gluster/web/{{team_name}}/{{project_name}}/{{service_name}}
    SERVICE_NAME: {{project_name}}_{{service_name}}
    DOCKER_COMPOSE_REPO_URL: git@{{gitlab_url | default("git3.nexdev.net")}}:ci/repos-ci/{{repo_name}}.git
    DOCKER_COMPOSE_REPO_BRANCH: master
    DOCKER_IMAGE_PATH: {{team_name}}/{{project_name}}_{{service_name}}
    DOCKER_IMAGE_PATH_LOCAL: {{team_name}}/{{project_name}}_{{service_name}}
    DOCKER_FILE_PATH: {{item.docker_file_path | default(".")}}
    DOCKER_FILE_NAME: {{item.docker_file_name | default("Dockerfile")}}
    CONFIG_FILE_PATH: {{item.config_file_path | default(".") | replace(separator_char,'/') }}
{% if item.sp_file_name is defined and item.sp_file_name != '' %}
    SP_FILE_PATH: {{item.sp_file_path | default("./App_Data") | replace(separator_char,'/') }}
    SP_FILE_NAME: {{item.sp_file_name}}
    SP_FILE_EXTENSION: {{item.sp_file_extension | default("xml")}}
    SP_FILE_TRANSFORM: {{item.sp_mapper | default('false')}}
{%endif%}
{% if item.config_file_name is defined %}
    CONFIG_FILE_NAME: {{ item.config_file_name }}
{% if item.config_file_ext | length > 0 %}
    CONFIG_FILE_EXTENSION: {{ item.config_file_ext }}
{%endif%}
{%endif%}
    STACK_NAME: {{project_name}}
    DOCKER_COMPOSE_FILE_PATH: {{item.docker_compose_file_path | default(".")}}
    DOCKER_COMPOSE_REPO_PATH: .docker-compose/{{ item.name | replace('-','_') }}