{% set service_name = project_name ~ '_' ~ item.name | replace('-','_') %}

#LOCAL
post_build_{{service_name}}_local:
  extends:
    - .deploy_vars_{{service_name}}
    - .post_build
    - .env:local
    - .deploy:local:{{service_name}}:rules
{% if item.multiple_image_env is undefined or item.multiple_image_env == false %}
  needs: ['scan_image_{{service_name}}']
{% else %}
  needs: ['scan_image_{{service_name}}_local']
{% endif %}

deploy_{{service_name}}_local:
  extends:
    - .deploy_vars_{{service_name}}
    - .deploy:local:base:swarm:stack
    - .deploy:local:{{service_name}}:rules
{% if item.platform is undefined or item.platform == "linux" %}
  needs: ['post_build_{{service_name}}_local']
{% else %}
  needs: ['build_image_{{service_name}}_local']
{% endif %}

{% if team_name != "nex3" and team_name != "pentagon" %}
{% if item.platform is undefined or item.platform == "linux" %}
