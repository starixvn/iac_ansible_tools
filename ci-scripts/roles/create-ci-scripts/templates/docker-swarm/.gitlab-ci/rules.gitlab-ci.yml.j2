.if-deploy-{{item.name | replace('_','-') }}-local: &if-deploy-{{item.name | replace('_','-') }}-local
  if: '$CI_COMMIT_TAG =~ /^deploy-{{item.name | replace('_','-') }}-local- */'

.if-deploy-{{item.name | replace('_','-') }}-local1: &if-deploy-{{item.name | replace('_','-') }}-local1
  if: '$CI_COMMIT_TAG =~ /^deploy-{{item.name | replace('_','-') }}-local1- */'

.if-deploy-{{item.name | replace('_','-') }}-sit: &if-deploy-{{item.name | replace('_','-') }}-sit
  if: '$CI_COMMIT_TAG =~ /^deploy-{{item.name | replace('_','-') }}-sit- */'

.if-deploy-{{item.name | replace('_','-') }}-uat: &if-deploy-{{item.name | replace('_','-') }}-uat
  if: '$CI_COMMIT_TAG =~ /^deploy-{{item.name | replace('_','-') }}-uat- */'

.if-deploy-{{item.name | replace('_','-') }}-prod: &if-deploy-{{item.name | replace('_','-') }}-prod
  if: '$CI_COMMIT_TAG =~ /^deploy-{{item.name | replace('_','-') }}-prod- */'

.build:image:{{item.name | replace('-','_') }}:rules:
  rules:
    - <<: *if-deploy-{{item.name | replace('_','-') }}-local
      when: always
    - <<: *if-deploy-{{item.name | replace('_','-') }}-local1
      when: always
    - <<: *if-deploy-{{item.name | replace('_','-') }}-sit
      when: always
    - <<: *if-deploy-{{item.name | replace('_','-') }}-uat
      when: always
    - <<: *if-deploy-{{item.name | replace('_','-') }}-prod
      when: always

.deploy:local:{{item.name | replace('-','_') }}:rules:
  rules:
    - <<: *if-deploy-{{item.name | replace('_','-') }}-local
      when: on_success
    - when: never

.deploy:local1:{{item.name | replace('-','_') }}:rules:
  rules:
    - <<: *if-deploy-{{item.name | replace('_','-') }}-local1
      when: on_success
    - when: never

.deploy:sit:{{item.name | replace('-','_') }}:rules:
  rules:
    - <<: *if-deploy-{{item.name | replace('_','-') }}-sit
      when: on_success
    - when: never

.deploy:uat:{{item.name | replace('-','_') }}:rules:
  rules:
    - <<: *if-deploy-{{item.name | replace('_','-') }}-uat
      when: on_success
    - when: never

.deploy:prod:{{item.name | replace('-','_') }}:rules:
  rules:
    - <<: *if-deploy-{{item.name | replace('_','-') }}-prod
      when: on_success
    - when: never

