{% for version in item.versions|default('0') %}
.if-deploy-{{item.name | replace('_','-') }}-local{{ '' if version == 0 else version }}: &if-deploy-{{item.name | replace('_','-') }}-local{{ '' if version == 0 else version }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{item.name | replace('_','-') }}-local{{ '' if version == 0 else version }}- */'

.if-deploy-{{item.name | replace('_','-') }}-sit{{ '' if version == 0 else version }}: &if-deploy-{{item.name | replace('_','-') }}-sit{{ '' if version == 0 else version }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{item.name | replace('_','-') }}-sit{{ '' if version == 0 else version }}- */'

.if-deploy-{{item.name | replace('_','-') }}-uat{{ '' if version == 0 else version }}: &if-deploy-{{item.name | replace('_','-') }}-uat{{ '' if version == 0 else version }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{item.name | replace('_','-') }}-uat{{ '' if version == 0 else version }}- */'

.if-deploy-{{item.name | replace('_','-') }}-prod{{ '' if version == 0 else version }}: &if-deploy-{{item.name | replace('_','-') }}-prod{{ '' if version == 0 else version }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{item.name | replace('_','-') }}-prod{{ '' if version == 0 else version }}- */'
{% endfor %}

.build:image:{{item.name | replace('-','_') }}:rules:
  rules:
{% for version in item.versions|default('0') %}
    - <<: *if-deploy-{{item.name | replace('_','-') }}-local{{ '' if version == 0 else version }}
      when: always
    - <<: *if-deploy-{{item.name | replace('_','-') }}-sit{{ '' if version == 0 else version }}
      when: always
    - <<: *if-deploy-{{item.name | replace('_','-') }}-uat{{ '' if version == 0 else version }}
      when: always
    - <<: *if-deploy-{{item.name | replace('_','-') }}-prod{{ '' if version == 0 else version }}
      when: always
{% endfor %}

{% for version in item.versions|default('0') %}
.deploy:local{{ '' if version == 0 else version }}:{{item.name | replace('-','_') }}:rules:
  rules:
    - <<: *if-deploy-{{item.name | replace('_','-') }}-local{{ '' if version == 0 else version }}
      when: on_success
    - when: never

.deploy:sit{{ '' if version == 0 else version }}:{{item.name | replace('-','_') }}:rules:
  rules:
    - <<: *if-deploy-{{item.name | replace('_','-') }}-sit{{ '' if version == 0 else version }}
      when: on_success
    - when: never

.deploy:uat{{ '' if version == 0 else version }}:{{item.name | replace('-','_') }}:rules:
  rules:
    - <<: *if-deploy-{{item.name | replace('_','-') }}-uat{{ '' if version == 0 else version }}
      when: on_success
    - when: never

.deploy:prod{{ '' if version == 0 else version }}:{{item.name | replace('-','_') }}:rules:
  rules:
    - <<: *if-deploy-{{item.name | replace('_','-') }}-prod{{ '' if version == 0 else version }}
      when: on_success
    - when: never
{% endfor %}



