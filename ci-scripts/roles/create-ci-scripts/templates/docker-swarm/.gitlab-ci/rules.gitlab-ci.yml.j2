{% set service_name = project_name ~ '_' ~ item.name | replace('-','_') %}
{% set rule_name = project_name | replace('_','-') ~ '-' ~ item.name | replace('_','-') %}

.if-deploy-{{rule_name}}-local: &if-deploy-{{rule_name}}-local
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-local\d*- */ && $DEPLOY_BY == "rocketor"'
{% if team_name != "nex3" and team_name != "pentagon" %}
.if-deploy-{{rule_name}}-nexprod: &if-deploy-{{rule_name}}-nexprod
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-nexprod\d*- */ && $DEPLOY_BY == "rocketor"'

.if-deploy-{{rule_name}}-aws2: &if-deploy-{{rule_name}}-aws2
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-aws2\d*- */ && $DEPLOY_BY == "rocketor"'

.if-deploy-{{rule_name}}-gc: &if-deploy-{{rule_name}}-gc
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-gc\d*- */ && $DEPLOY_BY == "rocketor"'

.if-deploy-{{rule_name}}-alphaprod: &if-deploy-{{rule_name}}-alphaprod
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-alphaprod\d*- */ && $DEPLOY_BY == "rocketor"'

.if-deploy-{{rule_name}}-fpsprod: &if-deploy-{{rule_name}}-fpsprod
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-fpsprod\d*- */ && $DEPLOY_BY == "rocketor"'

{% endif %}

.if-deploy-{{rule_name}}-sit: &if-deploy-{{rule_name}}-sit
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-sit\d*- */ && $DEPLOY_BY == "rocketor"'

.if-deploy-{{rule_name}}-uat: &if-deploy-{{rule_name}}-uat
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-uat\d*- */ && $DEPLOY_BY == "rocketor"'

.if-deploy-{{rule_name}}-prod: &if-deploy-{{rule_name}}-prod
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-prod\d*- */ && $DEPLOY_BY == "rocketor"'

.if-deploy-{{rule_name}}-aws: &if-deploy-{{rule_name}}-aws
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-aws\d*- */ && $DEPLOY_BY == "rocketor"'

.scan:config:{{service_name}}:rules:
  rules:
    - if: '$CI_COMMIT_TAG =~ /^deploy- */'
      when: never
    - changes:
        - "Dockerfile"
        - "*/Dockerfile"
        - "*/*ockerfile"
        - "*ockerfile"

.build:image:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-local
      when: always
{% if team_name != "nex3" and team_name != "pentagon" %}
    - <<: *if-deploy-{{rule_name}}-nexprod
      when: always
    - <<: *if-deploy-{{rule_name}}-aws2
      when: always
    - <<: *if-deploy-{{rule_name}}-gc
      when: always
    - <<: *if-deploy-{{rule_name}}-fpsprod
      when: always
    - <<: *if-deploy-{{rule_name}}-alphaprod
      when: always  
{% endif %}
    - <<: *if-deploy-{{rule_name}}-sit
      when: always
    - <<: *if-deploy-{{rule_name}}-uat
      when: always
    - <<: *if-deploy-{{rule_name}}-prod
      when: always
    - <<: *if-deploy-{{rule_name}}-aws
      when: always

.scan:image:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-local
      when: on_success
{% if team_name != "nex3" and team_name != "pentagon" %}
    - <<: *if-deploy-{{rule_name}}-nexprod
      when: on_success
    - <<: *if-deploy-{{rule_name}}-aws2
      when: on_success
    - <<: *if-deploy-{{rule_name}}-gc
      when: on_success
    - <<: *if-deploy-{{rule_name}}-alphaprod
      when: on_success
    - <<: *if-deploy-{{rule_name}}-fpsprod
      when: on_success
{% endif %}
    - <<: *if-deploy-{{rule_name}}-sit
      when: on_success
    - <<: *if-deploy-{{rule_name}}-uat
      when: on_success
    - <<: *if-deploy-{{rule_name}}-prod
      when: on_success
    - <<: *if-deploy-{{rule_name}}-aws
      when: on_success
    - when: never

.deploy:local:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-local
      when: on_success
    - when: never

{% if team_name != "nex3" and team_name != "pentagon" %}
.deploy:nexprod:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-nexprod
      when: on_success
    - when: never

.deploy:nexprod:{{service_name}}:manual:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-nexprod
      when: manual
    - when: never

.deploy:aws2:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-aws2
      when: on_success
    - when: never

.deploy:aws2:{{service_name}}:manual:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-aws2
      when: manual
    - when: never

.deploy:gc:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-gc
      when: on_success
    - when: never

.deploy:gc:{{service_name}}:manual:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-gc
      when: manual
    - when: never

.deploy:fpsprod:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-fpsprod
      when: on_success
    - when: never

.deploy:fpsprod:{{service_name}}:manual:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-fpsprod
      when: manual
    - when: never

.deploy:alphaprod:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-alphaprod
      when: on_success
    - when: never

.deploy:alphaprod:{{service_name}}:manual:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-alphaprod
      when: manual
    - when: never

{% endif %}

.deploy:sit:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-sit
      when: on_success
    - when: never

.deploy:uat:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-uat
      when: on_success
    - when: never

.deploy:prod:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-prod
      when: on_success
    - when: never

.deploy:prod:{{service_name}}:manual:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-prod
      when: manual
    - when: never
    
.deploy:aws:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-aws
      when: on_success
    - when: never

.deploy:aws:{{service_name}}:manual:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-aws
      when: manual
    - when: never
