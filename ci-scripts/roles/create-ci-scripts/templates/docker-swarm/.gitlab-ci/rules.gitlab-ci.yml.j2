{% set service_name = item.name | replace('-','_') %}
{% set rule_name = project_name | replace('_','-') ~ '-' ~ item.name | replace('_','-') %}
{% for version in versions %}
{% set version_number = '' if version == 0 else version %}

.if-deploy-local{{ version_number }}: &if-deploy-local{{ version_number }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{project_name}}-local{{ version_number }}-\d{8}-\d+.*$ */'

.if-deploy-{{rule_name}}-local{{ version_number }}: &if-deploy-{{rule_name}}-local{{ version_number }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-local{{ version_number }}- */'

.if-deploy-nexprod{{ version_number }}: &if-deploy-nexprod{{ version_number }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{project_name}}-nexprod{{ version_number }}-\d{8}-\d+.*$ */'

.if-deploy-{{rule_name}}-nexprod{{ version_number }}: &if-deploy-{{rule_name}}-nexprod{{ version_number }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-nexprod{{ version_number }}- */'

.if-deploy-sit{{ version_number }}: &if-deploy-sit{{ version_number }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{project_name}}-sit{{ version_number }}-\d{8}-\d+.*$ */'

.if-deploy-{{rule_name}}-sit{{ version_number }}: &if-deploy-{{rule_name}}-sit{{ version_number }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-sit{{ version_number }}- */'

.if-deploy-uat{{ version_number }}: &if-deploy-uat{{ version_number }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{project_name}}-uat{{ version_number }}-\d{8}-\d+.*$ */'

.if-deploy-{{rule_name}}-uat{{ version_number }}: &if-deploy-{{rule_name}}-uat{{ version_number }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-uat{{ version_number }}- */'

.if-deploy-{{rule_name}}-prod{{ version_number }}: &if-deploy-{{rule_name}}-prod{{ version_number }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-prod{{ version_number }}- */'

.if-deploy-{{rule_name}}-aws{{ version_number }}: &if-deploy-{{rule_name}}-aws{{ version_number }}
  if: '$CI_COMMIT_TAG =~ /^deploy-{{rule_name}}-aws{{ version_number }}- */'

{% endfor %}

.build:image:{{service_name}}:rules:
  rules:
{% for version in versions %}
{% set version_number = '' if version == 0 else version %}
    - <<: *if-deploy-local{{ version_number }}
      when: always
    - <<: *if-deploy-nexprod{{ version_number }}
      when: always
    - <<: *if-deploy-sit{{ version_number }}
      when: always
    - <<: *if-deploy-uat{{ version_number }}
      when: always
    - <<: *if-deploy-{{rule_name}}-local{{ version_number }}
      when: always
    - <<: *if-deploy-{{rule_name}}-nexprod{{ version_number }}
      when: always
    - <<: *if-deploy-{{rule_name}}-sit{{ version_number }}
      when: always
    - <<: *if-deploy-{{rule_name}}-uat{{ version_number }}
      when: always
    - <<: *if-deploy-{{rule_name}}-prod{{ version_number }}
      when: always
    - <<: *if-deploy-{{rule_name}}-aws{{ version_number }}
      when: always
{% endfor %}

.scan:image:{{service_name}}:rules:
  rules:
{% for version in versions %}
{% set version_number = '' if version == 0 else version %}
    - <<: *if-deploy-local{{ version_number }}
      when: on_success
    - <<: *if-deploy-sit{{ version_number }}
      when: on_success
    - <<: *if-deploy-uat{{ version_number }}
      when: on_success
    - <<: *if-deploy-{{rule_name}}-local{{ version_number }}
      when: on_success
    - <<: *if-deploy-{{rule_name}}-sit{{ version_number }}
      when: on_success
    - <<: *if-deploy-{{rule_name}}-uat{{ version_number }}
      when: on_success
    - <<: *if-deploy-{{rule_name}}-prod{{ version_number }}
      when: on_success
    - <<: *if-deploy-{{rule_name}}-aws{{ version_number }}
      when: on_success
{% endfor %}
    - when: never

{% for version in versions %}
{% set version_number = '' if version == 0 else version %}
.deploy:local{{ version_number }}:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-local{{ version_number }}
      when: on_success
    - <<: *if-deploy-{{rule_name}}-local{{ version_number }}
      when: on_success
    - when: never

.deploy:nexprod{{ version_number }}:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-nexprod{{ version_number }}
      when: on_success
    - <<: *if-deploy-{{rule_name}}-nexprod{{ version_number }}
      when: on_success
    - when: never

.deploy:sit{{ version_number }}:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-sit{{ version_number }}
      when: on_success
    - <<: *if-deploy-{{rule_name}}-sit{{ version_number }}
      when: on_success
    - when: never

.deploy:uat{{ version_number }}:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-uat{{ version_number }}
      when: on_success
    - <<: *if-deploy-{{rule_name}}-uat{{ version_number }}
      when: on_success
    - when: never

.deploy:prod{{ version_number }}:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-prod{{ version_number }}
      when: on_success
    - when: never

.deploy:prod{{ version_number }}:{{service_name}}:manual:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-prod{{ version_number }}
      when: manual
    - when: never
    
.deploy:aws{{ version_number }}:{{service_name}}:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-aws{{ version_number }}
      when: on_success
    - when: never

.deploy:aws{{ version_number }}:{{service_name}}:manual:rules:
  rules:
    - <<: *if-deploy-{{rule_name}}-aws{{ version_number }}
      when: manual
    - when: never

{% endfor %}



