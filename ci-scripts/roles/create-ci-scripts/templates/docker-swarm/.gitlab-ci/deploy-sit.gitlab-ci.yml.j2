{% for version in item.versions|default('0') %}
post_build_{{item.name | replace('-','_') }}_sit{{ '' if version == 0 else version }}:
  extends:
    - .deploy_vars_{{item.name | replace('-','_') }}
    - .post_build
    - .deploy:sit{{ '' if version == 0 else version }}
    - .deploy:sit{{ '' if version == 0 else version }}:{{item.name | replace('-','_') }}:rules
  needs: ['build_image_{{item.name | replace('-','_') }}']

deploy_{{item.name | replace('-','_') }}_sit{{ '' if version == 0 else version }}:
  extends:
    - .deploy_vars_{{item.name | replace('-','_') }}
    - .deploy:sit{{ '' if version == 0 else version }}:base:swarm:stack
    - .deploy:sit{{ '' if version == 0 else version }}:{{item.name | replace('-','_') }}:rules
  needs: ['post_build_{{item.name | replace('-','_') }}_sit{{ '' if version == 0 else version }}']

{% endfor %}