pre_deploy_{{item.name | replace('-','_') }}:
  extends:
    - .deploy_vars_{{item.name | replace('-','_') }}
    - .build:image:{{item.name | replace('-','_') }}:rules
  scripts:
    - echo "Create volume folder"
{% if item.volumes is defined %}
{% for volume in item.volumes %}
    - ssh -o ProxyCommand="${PROXY_SSH_COMMAND}" -o StrictHostKeyChecking=no -p $SERVER_PORT $SERVER_USER@$SERVER_IP "mkdir -p /var/www/gluster/web/{{volume.src}}/{{env | upper}}{{ '' if item.1 == 0  else '_' }}{{'' if item.1 == 0  else item.1 }}";
{% endfor %}
{% endif %}
    
