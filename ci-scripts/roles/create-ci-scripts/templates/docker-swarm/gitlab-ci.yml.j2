stages:
{% if sonarqube_enabled is defined and sonarqube_enabled == true %}
  - test
{%endif%}
{% if frameworks is defined and "cocos" in frameworks %}
  - build-cocos-web
{%endif%}
  - build
  - post-build
  - deploy

variables:
  DOCKER_COMPOSE_REPO_URL: git@{{gitlab_url | default("git3.nexdev.net")}}:ci/repos-ci/{{repo_name}}.git
{% if sonarqube_enabled is defined and sonarqube_enabled == true %}
  PROJECT_NAME: {{sonarqube_project_name}}
{%endif%}

include:
{% if sonarqube_enabled is defined and sonarqube_enabled == true %}
  - project: 'ci/common-ci'
    ref: rocketor
{% if frameworks is defined and "dotnet" in frameworks %}
    file: 'sonarqube/sonarqube-dotnet.gitlab-ci.yml'
{% else %}
    file: 'sonarqube/sonarqube.gitlab-ci.yml'
{%endif%}
{%endif%}
  - project: 'ci/common-ci'
    ref: rocketor
    file: 'rocketor-integration/rules/index.gitlab-ci.yml'
  - project: 'ci/common-ci'
    ref: rocketor
    file: 'docker/base/build-docker-image.gitlab-ci.yml'
  - project: 'ci/common-ci'
    ref: rocketor
    file: 'docker/base/post-build-docker-image.gitlab-ci.yml'
  - project: 'ci/common-ci'
    ref: rocketor
    file: '_teams/{{org_name}}/{{ci_group_name}}/deploy-docker-swarm-stack/index.gitlab-ci.yml'
{% for service in services %}
  - .gitlab-ci/{{service.name | replace('-','_') }}/build.gitlab-ci.yml
{% if service.framework is defined and service.framework == "cocos" %}
  - .gitlab-ci/{{service.name | replace('-','_') }}/build-cocos-web.gitlab-ci.yml
{%endif%}
  - .gitlab-ci/{{service.name | replace('-','_') }}/deploy-vars.gitlab-ci.yml
  - .gitlab-ci/{{service.name | replace('-','_') }}/rules.gitlab-ci.yml
  - .gitlab-ci/{{service.name | replace('-','_') }}/deploy-local.gitlab-ci.yml
  - .gitlab-ci/{{service.name | replace('-','_') }}/deploy-sit.gitlab-ci.yml
  - .gitlab-ci/{{service.name | replace('-','_') }}/deploy-uat.gitlab-ci.yml
  - .gitlab-ci/{{service.name | replace('-','_') }}/deploy-prod.gitlab-ci.yml
  - .gitlab-ci/{{service.name | replace('-','_') }}/deploy-aws.gitlab-ci.yml
{% endfor %}
